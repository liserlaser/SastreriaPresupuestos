<Window x:Class="SastreriaPresupuestos.Views.PricesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de precios"
        Height="680"
        Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#F5F1EB"
        Language="es-ES">

    <Window.Resources>

        <!-- COLORES BASE -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#ebf5ec"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F332D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A8B2A1"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D7468"/>
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#D7DDD2"/>

        <!-- TEXTOS -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <!-- BOTONES BASE -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- BOTÓN PRINCIPAL DORADO -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- BOTÓN SECUNDARIO CLARO -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#afbdac"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#a8bfa6"/>
        </Style>

        <!-- DATAGRID -->
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEE8DE"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAF7F1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#adbdac"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <StackPanel Margin="0,0,0,24">

            <TextBlock
                Text="CONFIGURACIÓN DE PRECIOS"
                FontSize="30"
                FontWeight="Bold"/>

            <TextBlock
                Text="Modifica las tarifas base que se aplicarán a nuevos productos y cambios futuros"
                FontSize="14"
                Foreground="{StaticResource MutedTextBrush}"
                Margin="0,4,0,0"/>

        </StackPanel>

        <!-- TARJETA TABLA -->
        <Border
            Grid.Row="1"
            Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="14"
            Padding="18"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1">

            <DataGrid
                x:Name="PricesDataGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="False"
                RowHeight="42"
                FontSize="14"
                AlternationCount="2"
                SelectionMode="Single"
                SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Producto"
                        Binding="{Binding ProductName}"
                        IsReadOnly="True"
                        Width="*" />

                    <DataGridTextColumn
                        Header="Tipo"
                        Binding="{Binding TailoringType}"
                        IsReadOnly="True"
                        Width="220" />

                    <DataGridTextColumn
                        Header="Precio"
                        Binding="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
                        ElementStyle="{StaticResource RightAlignedCellStyle}"
                        Width="170" />

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- BOTONES -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,22,0,0">

            <Button
                Content="Cancelar"
                Width="130"
                Height="42"
                Margin="0,0,10,0"
                FontSize="16"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="CancelButton_Click"/>

            <Button
                Content="Guardar"
                Width="130"
                Height="42"
                FontSize="16"
                Style="{StaticResource PrimaryActionButtonStyle}"
                Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>
</Window>