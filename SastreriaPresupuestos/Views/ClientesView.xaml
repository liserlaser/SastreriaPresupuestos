<UserControl x:Class="SastreriaPresupuestos.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

                    <Grid Margin="0,0,0,0">
                        <Border
							Background="{StaticResource CardBackgroundBrush}"
							CornerRadius="14"
							Padding="22"
							BorderBrush="{StaticResource BorderSoftBrush}"
							BorderThickness="1">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- CLIENTES -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,10">

                                        <TextBlock
											Text="CLIENTES"
											FontSize="18"
											FontWeight="Bold"
											Foreground="{StaticResource PrimaryBrush}"
											VerticalAlignment="Center"
											DockPanel.Dock="Left"/>

                                        <StackPanel
											Orientation="Horizontal"
											HorizontalAlignment="Right"
											DockPanel.Dock="Right">

                                            <Button
												x:Name="NewClientButton"
												Content="+"
												Width="30"
												Height="28"
												FontSize="12"
												Margin="0,0,6,0"
												ToolTip="Nuevo cliente"
												Style="{StaticResource SmallLightButtonStyle}"/>

                                            <Button
												x:Name="DeleteClientButton"
												Content="✕"
												Width="30"
												Height="28"
												FontSize="10"
												ToolTip="Eliminar cliente"
												Style="{StaticResource DangerSmallButtonStyle}"/>

                                        </StackPanel>

                                    </DockPanel>

                                    <!-- BUSCADOR -->
                                    <Grid
										Grid.Row="1"
										Margin="0,0,0,12">

                                        <TextBox
											x:Name="ClientSearchTextBox"
											Height="26"
											FontSize="14"
											VerticalContentAlignment="Center"
											ToolTip="Buscar por nombre, teléfono, fecha, estado o título"
											TextChanged="ClientSearchTextBox_TextChanged"/>

                                        <TextBlock
											x:Name="ClientSearchPlaceholderTextBlock"
											Text="Buscar cliente, teléfono, fecha..."
											Foreground="{StaticResource MutedTextBrush}"
											Margin="10,0,0,0"
											VerticalAlignment="Center"
											IsHitTestVisible="False"/>

                                    </Grid>

                                    <!-- FILTROS ESTADO -->
                                    <WrapPanel
										x:Name="StatusFiltersPanel"
										Grid.Row="2"
										Margin="0,0,0,8">

                                        <Button
											Content="Todos"
											Tag="Todos"
											Height="26"
											Margin="0,0,6,6"
											Padding="10,4"
											FontSize="12"
											Style="{StaticResource SecondaryButtonStyle}"
											Click="StatusFilterButton_Click"/>

                                        <Button
											Content="Pendiente"
											Tag="Pendiente"
											Height="26"
											Margin="0,0,6,6"
											Padding="10,4"
											FontSize="12"
											Style="{StaticResource SecondaryButtonStyle}"
											Click="StatusFilterButton_Click"/>

                                        <Button
											Content="Aceptado"
											Tag="Aceptado"
											Height="26"
											Margin="0,0,6,6"
											Padding="10,4"
											FontSize="12"
											Style="{StaticResource SecondaryButtonStyle}"
											Click="StatusFilterButton_Click"/>

                                        <Button
											Content="Rechazado"
											Tag="Rechazado"
											Height="26"
											Margin="0,0,6,6"
											Padding="10,4"
											FontSize="12"
											Style="{StaticResource SecondaryButtonStyle}"
											Click="StatusFilterButton_Click"/>

                                        <Button
											Content="Entregado"
											Tag="Entregado"
											Height="26"
											Margin="0,0,6,6"
											Padding="10,4"
											FontSize="12"
											Style="{StaticResource SecondaryButtonStyle}"
											Click="StatusFilterButton_Click"/>

                                    </WrapPanel>

                                    <!-- FILTROS ENTREGA -->
                                    <WrapPanel
										x:Name="DeliveryFiltersPanel"
										Grid.Row="3"
										Margin="0,0,0,12">

                                        <Button
											Content="Todas"
											Tag="Todas"
											Height="26"
											Margin="0,0,6,6"
											Padding="10,4"
											FontSize="12"
											Style="{StaticResource SecondaryButtonStyle}"
											Click="DeliveryFilterButton_Click"/>

                                        <Button
											Content="Próximas"
											Tag="Próximas"
											Height="26"
											Margin="0,0,6,6"
											Padding="10,4"
											FontSize="12"
											Style="{StaticResource SecondaryButtonStyle}"
											Click="DeliveryFilterButton_Click"/>

                                        <Button
											Content="Semana"
											Tag="Semana"
											Height="26"
											Margin="0,0,6,6"
											Padding="10,4"
											FontSize="12"
											Style="{StaticResource SecondaryButtonStyle}"
											Click="DeliveryFilterButton_Click"/>

                                        <Button
											Content="Mes"
											Tag="Mes"
											Height="26"
											Margin="0,0,6,6"
											Padding="10,4"
											FontSize="12"
											Style="{StaticResource SecondaryButtonStyle}"
											Click="DeliveryFilterButton_Click"/>

                                        <Button
											Content="Sin presupuesto"
											Tag="Sin presupuesto"
											Height="26"
											Margin="0,0,6,6"
											Padding="10,4"
											FontSize="12"
											Style="{StaticResource SecondaryButtonStyle}"
											Click="DeliveryFilterButton_Click"/>

                                    </WrapPanel>

                                    <!-- LISTA CLIENTES -->
                                    <ListBox
										x:Name="ClientsListBox"
										Grid.Row="4"
										Margin="0"
										HorizontalContentAlignment="Stretch"
										ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                                        MouseDoubleClick="ClientsListBox_MouseDoubleClick">

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock
														Text="{Binding Name}"
														FontSize="15"
														FontWeight="SemiBold"/>

                                                    <TextBlock
														Grid.Row="1"
														Text="{Binding DisplayPhone}"
														FontSize="12"
														Foreground="{StaticResource MutedTextBrush}"
														Margin="0,3,0,0"/>

                                                    <TextBlock
														Grid.Row="2"
														Text="{Binding DeliveryDateText}"
														FontSize="13"
														Foreground="{StaticResource MutedTextBrush}"
														Margin="0,3,0,0"/>

                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                </Grid>

                                <!-- COLUMNA DERECHA: PRESUPUESTOS -->
                                <Grid Grid.Column="2">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- FICHA RÁPIDA DEL CLIENTE -->
                                    <Border
                                        Grid.Row="0"
                                        Background="#F8FAF6"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="0,0,0,16">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock
                                                        x:Name="ClientDetailNameTextBlock"
                                                        Text="Selecciona un cliente"
                                                        FontSize="20"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource PrimaryBrush}"/>

                                                    <TextBlock
                                                        x:Name="ClientDetailMetaTextBlock"
                                                        Text="Busca o selecciona un cliente para ver su ficha rápida."
                                                        FontSize="13"
                                                        Foreground="{StaticResource MutedTextBrush}"
                                                        Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel
                                                    DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">

                                                    <Button
                                                        x:Name="NewQuoteFromClientButton"
                                                        Content="+ Presupuesto"
                                                        Height="32"
                                                        Margin="0,0,8,0"
                                                        Style="{StaticResource PrimaryActionButtonStyle}"/>

                                                    <Button
                                                        x:Name="OpenSelectedClientQuoteButton"
                                                        Content="Abrir"
                                                        Height="32"
                                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Teléfono" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                                    <TextBlock x:Name="ClientDetailPhoneTextBlock" Text="—" FontSize="14" Margin="0,3,10,0"/>
                                                </StackPanel>

                                                <StackPanel>
                                                    <TextBlock Text="DNI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                                    <TextBlock x:Name="ClientDetailDniTextBlock" Text="—" FontSize="14" Margin="0,3,10,0"/>
                                                </StackPanel>

                                                <StackPanel>
                                                    <TextBlock Text="Próxima entrega" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                                    <TextBlock x:Name="ClientDetailNextDeliveryTextBlock" Text="—" FontSize="14" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock
                                                x:Name="ClientDetailSummaryTextBlock"
                                                Grid.Row="2"
                                                Text="Sin cliente seleccionado."
                                                FontSize="13"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Margin="0,12,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- PRESUPUESTOS DEL CLIENTE -->
                                    <TextBlock
										Grid.Row="1"
										Text="PRESUPUESTOS DEL CLIENTE"
										FontSize="18"
										FontWeight="Bold"
										Foreground="{StaticResource PrimaryBrush}"
										Margin="0,0,0,10"/>

                                    <ListBox
										x:Name="QuotesListBox"
										Grid.Row="2"
										HorizontalContentAlignment="Stretch"
										ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border
													Background="{Binding CardBackground}"
													BorderBrush="{Binding CardBorderBrush}"
													BorderThickness="{Binding CardBorderThickness}"
													CornerRadius="10"
													Padding="12"
													Margin="0,0,0,8">

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="34"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Nombre del pedido -->
                                                        <TextBlock
															Text="{Binding DisplayTitle}"
															FontSize="15"
															FontWeight="{Binding TitleWeight}"/>

                                                        <!-- Entrega -->
                                                        <TextBlock
															Grid.Row="1"
															Text="{Binding DeliveryDate, StringFormat=Entrega: {0:dd/MM/yyyy}}"
															FontSize="12"
															Foreground="{StaticResource MutedTextBrush}"
															Margin="0,3,0,0"/>

                                                        <!-- Estado -->
                                                        <StackPanel
															Grid.Row="2"
															Orientation="Horizontal"
															Margin="0,4,0,0">

                                                            <TextBlock
																Text="Estado: "
																FontSize="12"
																Foreground="{StaticResource MutedTextBrush}"
																VerticalAlignment="Center"/>

                                                            <Border
																Background="{Binding StatusBackground}"
																CornerRadius="8"
																Padding="8,3">

                                                                <TextBlock
																	Text="{Binding StatusLabelText}"
																	FontSize="12"
																	FontWeight="Bold"
																	Foreground="{Binding StatusForeground}"/>
                                                            </Border>

                                                        </StackPanel>

                                                        <!-- Total -->
                                                        <TextBlock
															Grid.Row="3"
															Text="{Binding Total, StringFormat=Total: {0:N2} €, ConverterCulture=es-ES}"
															FontSize="13"
															FontWeight="SemiBold"
															Foreground="{StaticResource PrimaryBrush}"
															Margin="0,4,0,0"/>

                                                        <!-- Productos -->
                                                        <TextBlock
															Grid.Row="4"
															Text="{Binding ProductSummary}"
															FontSize="12"
															Foreground="{StaticResource MutedTextBrush}"
															TextWrapping="Wrap"
															Margin="0,5,8,0"/>

                                                        <!-- Eliminar presupuesto -->
                                                        <Button
															Grid.Column="1"
															Grid.RowSpan="5"
															Content="✕"
															FontSize="8"
															Width="28"
															Height="26"
															VerticalAlignment="Top"
															ToolTip="Eliminar presupuesto"
															Click="DeleteQuote_Click"
															Style="{StaticResource DangerSmallButtonStyle}"/>

                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                </Grid>

                            </Grid>

                        </Border>
                    </Grid>
                </UserControl>
