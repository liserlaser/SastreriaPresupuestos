<UserControl x:Class="SastreriaPresupuestos.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <UserControl.Resources>
        <x:Array Type="{x:Type sys:String}" x:Key="ProductList">
            <sys:String>Traje</sys:String>
            <sys:String>Chaqué</sys:String>
            <sys:String>Chaleco</sys:String>
            <sys:String>Chaqueta</sys:String>
            <sys:String>Pantalón</sys:String>
            <sys:String>Camisa</sys:String>
            <sys:String>Corbata</sys:String>
            <sys:String>Pañuelo</sys:String>
            <sys:String>Gemelos</sys:String>
            <sys:String>Tirantes</sys:String>
            <sys:String>Zapatos</sys:String>
            <sys:String>Concepto Libre</sys:String>
        </x:Array>
    </UserControl.Resources>

                    <Grid Margin="0,0,0,0">

                        <!-- PRODUCTOS -->
                        <Border
							Background="{StaticResource CardBackgroundBrush}"
							CornerRadius="14"
							Padding="22"
							BorderBrush="{StaticResource BorderSoftBrush}"
							BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock
											Text="PRODUCTOS DEL TRABAJO"
											FontSize="12"
											FontWeight="Bold"
                                            Foreground="{StaticResource AccentBrush}"/>

                                        <TextBlock
											Text="Prendas, complementos y conceptos del presupuesto"
											FontSize="20"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource PrimaryBrush}"
											Margin="0,3,0,0"/>

                                        <Border
											x:Name="ProductsEmptyHintBorder"
											Background="#F8FAF6"
											BorderBrush="{StaticResource BorderSoftBrush}"
											BorderThickness="1"
											CornerRadius="12"
											Padding="12"
											Margin="0,12,0,0"
											Visibility="Collapsed">

                                            <TextBlock
												x:Name="ProductsEmptyHintTextBlock"
												Text="Crea o selecciona un trabajo antes de añadir productos."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"/>

                                        </Border>
                                    </StackPanel>

                                    <StackPanel
										Grid.Column="1"
										Orientation="Horizontal"
										HorizontalAlignment="Right"
                                        VerticalAlignment="Top">

                                        <TextBlock
											x:Name="ProductsUnsavedChangesTextBlock"
											Text="Cambios sin guardar"
											VerticalAlignment="Center"
											FontWeight="SemiBold"
											Foreground="{StaticResource AccentBrush}"
											Margin="0,0,14,0"
											Visibility="Collapsed"/>

                                        <Button
											Content="+ Producto"
											Width="130"
											Height="38"
											Margin="0,0,8,0"
											x:Name="AddProductButton"
											Style="{StaticResource PrimaryActionButtonStyle}"/>

                                        <Button
											x:Name="SaveProductsButton"
											Content="Guardar"
											Width="110"
											Height="38"
											FontSize="14"
											Style="{StaticResource SecondaryButtonStyle}"/>

                                    </StackPanel>

                                </Grid>

                                <!-- TABLA -->
                                <DataGrid
									Grid.Row="1"
									x:Name="ProductsDataGrid"
									PreparingCellForEdit="ProductsDataGrid_PreparingCellForEdit"
									AutoGenerateColumns="False"
									CanUserAddRows="False"
									HeadersVisibility="Column"
									RowHeight="42"
									FontSize="14"
									IsReadOnly="False"
									IsSynchronizedWithCurrentItem="True"
									AlternationCount="2"
									SelectionMode="Single"
									SelectionUnit="FullRow"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    GridLinesVisibility="None"
                                    RowBackground="#FFFDFB"
                                    AlternatingRowBackground="#FAF6F1"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto"
                                    EnableRowVirtualization="True"
                                    EnableColumnVirtualization="True">

                                    <DataGrid.Columns>

                                        <!-- CANTIDAD -->
                                        <DataGridTextColumn
											Header="Cant."
											Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											ElementStyle="{StaticResource CenterAlignedCellStyle}"
											EditingElementStyle="{StaticResource QuantityEditingTextBoxStyle}"
											Width="70" />

                                        <!-- PRODUCTO -->
                                        <DataGridTemplateColumn Header="Producto" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox
														ItemsSource="{StaticResource ProductList}"
														SelectedItem="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
														VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- TIPO -->
                                        <DataGridTemplateColumn Header="Tipo" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox
														ItemsSource="{Binding AvailableTailoringTypes}"
														SelectedItem="{Binding TailoringType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
														VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- TEJIDO -->
                                        <DataGridTextColumn
											Header="Tejido / Ref."
											Binding="{Binding Fabric, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											ElementStyle="{StaticResource FabricCellStyle}"
											EditingElementStyle="{StaticResource FabricEditingTextBoxStyle}"
											Width="*" />

                                        <!-- PRECIO -->
                                        <DataGridTextColumn
											Header="Precio"
											Binding="{Binding BasePrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											EditingElementStyle="{StaticResource MoneyEditingTextBoxStyle}"
											Width="115" />

                                        <!-- PRECIO TEJIDO -->
                                        <DataGridTextColumn
											Header="Precio Tejido"
											Binding="{Binding FabricPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											EditingElementStyle="{StaticResource MoneyEditingTextBoxStyle}"
											Width="115" />


                                        <!-- TOTAL -->
                                        <DataGridTextColumn
											Header="Total"
											Binding="{Binding Total, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											IsReadOnly="True"
											Width="125" />

                                        <!-- ACCIONES -->
                                        <DataGridTemplateColumn Header="" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                        <Button
															Content="↑"
															FontSize="12"
															Width="34"
															Height="32"
															Margin="0,0,4,0"
															ToolTip="Mover arriba"
															Click="MoveProductUp_Click"
															Style="{StaticResource SmallLightButtonStyle}"/>

                                                        <Button
															Content="↓"
															FontSize="12"
															Width="34"
															Height="32"
															Margin="0,0,6,0"
															ToolTip="Mover abajo"
															Click="MoveProductDown_Click"
															Style="{StaticResource SmallLightButtonStyle}"/>

                                                        <Button
															Content="⧉"
															FontSize="12"
															Width="34"
															Height="32"
															Margin="0,0,6,0"
															ToolTip="Duplicar línea"
															Click="DuplicateProduct_Click"
															Style="{StaticResource SmallLightButtonStyle}"/>

                                                        <Button
															Content="✕"
															FontSize="12"
															Width="34"
															Height="32"
															ToolTip="Eliminar línea"
															Click="DeleteProduct_Click"
															Style="{StaticResource DangerSmallButtonStyle}"/>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>

                                </DataGrid>

                                <!-- TOTAL -->
                                <Border
									Grid.Row="2"
									HorizontalAlignment="Right"
									Margin="0,20,0,0"
									Background="#EEF2EA"
									BorderBrush="{StaticResource BorderSoftBrush}"
									BorderThickness="1"
									CornerRadius="10"
									Padding="18,10">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock
											Text="Total"
											FontSize="22"
											FontWeight="Bold"
											Foreground="{StaticResource AccentBrush}"
											Margin="0,0,18,0"/>

                                        <TextBlock
											Text="0,00 €"
											FontSize="22"
											FontWeight="Bold"
											Foreground="{StaticResource PrimaryBrush}"
											x:Name="TotalTextBlock"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Border>

                    </Grid>

</UserControl>
