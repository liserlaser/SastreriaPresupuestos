<UserControl x:Class="SastreriaPresupuestos.Views.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,0,0,0">

        <Border
            Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="14"
            Padding="22"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,24">

                    <TextBlock
                        Text="CONFIGURACIÓN"
                        FontSize="24"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Opciones de mantenimiento y configuración de la aplicación."
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <WrapPanel
                    Grid.Row="1"
                    ItemWidth="270">

                    <Border
                        Background="#F8FAF6"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,16,16">

                        <StackPanel>

                            <TextBlock
                                Text="Productos"
                                FontSize="18"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="Añade productos y modifica sus tipos, precios y categoría."
                                FontSize="13"
                                Foreground="{StaticResource MutedTextBrush}"
                                TextWrapping="Wrap"
                                Margin="0,6,0,14"/>

                            <Button
                                x:Name="PricesConfigButton"
                                Content="Editar Productos"
                                Height="40"
                                FontSize="15"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                        </StackPanel>

                    </Border>

                    <Border
                        Background="#F8FAF6"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,16,16">

                        <StackPanel>

                            <TextBlock
                                Text="Copia de seguridad"
                                FontSize="18"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="Crea una copia manual de la base de datos."
                                FontSize="13"
                                Foreground="{StaticResource MutedTextBrush}"
                                TextWrapping="Wrap"
                                Margin="0,6,0,14"/>

                            <Button
                                x:Name="BackupButton"
                                Content="Copia Seguridad"
                                Height="40"
                                FontSize="15"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                        </StackPanel>

                    </Border>

                    <Border
                        Background="#F8FAF6"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,16,16">

                        <StackPanel>

                            <TextBlock
                                Text="Carpetas de exportación"
                                FontSize="18"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="Elige dónde se guardan automáticamente la ficha del cliente, los presupuestos y el PDF de opciones."
                                FontSize="13"
                                Foreground="{StaticResource MutedTextBrush}"
                                TextWrapping="Wrap"
                                Margin="0,6,0,14"/>

                            <TextBlock
                                Text="Ficha cliente"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource MutedTextBrush}"/>

                            <TextBlock
                                x:Name="ClientSheetFolderTextBlock"
                                Text="Sin carpeta seleccionada"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,2,0,8"/>

                            <Button
                                x:Name="ClientSheetFolderButton"
                                Content="Seleccionar carpeta"
                                Height="34"
                                FontSize="13"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,0,12"/>

                            <TextBlock
                                Text="Presupuestos"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource MutedTextBrush}"/>

                            <TextBlock
                                x:Name="QuoteFolderTextBlock"
                                Text="Sin carpeta seleccionada"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,2,0,8"/>

                            <Button
                                x:Name="QuoteFolderButton"
                                Content="Seleccionar carpeta"
                                Height="34"
                                FontSize="13"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,0,12"/>

                            <TextBlock
                                Text="Opciones"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource MutedTextBrush}"/>

                            <TextBlock
                                x:Name="OptionsFolderTextBlock"
                                Text="Sin carpeta seleccionada"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,2,0,8"/>

                            <Button
                                x:Name="OptionsFolderButton"
                                Content="Seleccionar carpeta"
                                Height="34"
                                FontSize="13"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                        </StackPanel>

                    </Border>

                </WrapPanel>

            </Grid>

        </Border>

    </Grid>
</UserControl>
