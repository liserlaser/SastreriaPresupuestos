<UserControl x:Class="SastreriaPresupuestos.Views.FacturasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18"
                Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="FACTURAS"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>

                    <DockPanel Margin="0,12,0,0">
                        <TextBox x:Name="InvoiceSearchTextBox"
                                 Height="34"
                                 FontSize="14"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 DockPanel.Dock="Left"/>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="CreateInvoiceButton"
                                Content="+ Factura"
                                Height="36"
                                MinWidth="104"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>
                        <Button x:Name="ExportInvoiceButton"
                                Content="PDF"
                                Height="36"
                                MinWidth="72"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="PrintInvoiceButton"
                                Content="Imprimir"
                                Height="36"
                                MinWidth="86"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="InvoicesListBox"
                         Grid.Row="1"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding InvoiceNumber}"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Total, StringFormat={}{0:N2} €}"
                                           HorizontalAlignment="Right"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding ClientName}"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Summary}"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="InvoiceDetailNumberTextBlock"
                               Text="Selecciona una factura"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="InvoiceDetailMetaTextBlock"
                               Text="Las facturas emitidas se visualizan en modo solo lectura."
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#F8FAF6"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,16,0,12">
                    <StackPanel>
                        <TextBlock x:Name="InvoiceDetailClientTextBlock"
                                   Text="Cliente: —"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="InvoiceDetailSourceTextBlock"
                                   Text="Origen: —"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="InvoiceItemsDataGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="1.4*"/>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2} €}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="3" Margin="0,14,0,0">
                    <Button x:Name="CreateCorrectiveInvoiceButton"
                            Content="Crear rectificativa"
                            Height="36"
                            MinWidth="150"
                            DockPanel.Dock="Left"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <TextBlock x:Name="InvoiceDetailTotalTextBlock"
                               Text="Total: 0,00 €"
                               HorizontalAlignment="Right"
                               FontSize="18"
                               FontWeight="Bold"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
