<UserControl x:Class="SastreriaPresupuestos.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">



                    <Grid Margin="0,0,0,0">

                        <Border
							Background="{StaticResource CardBackgroundBrush}"
							CornerRadius="14"
							Padding="22"
							BorderBrush="{StaticResource BorderSoftBrush}"
							BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,18">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock
											Text="ENTREGAS"
											FontSize="24"
											FontWeight="Bold"/>

                                        <TextBlock
											x:Name="WeekTitleTextBlock" x:FieldModifier="public"
											Text="Semana actual"
											FontSize="14"
											Foreground="{StaticResource MutedTextBrush}"
											Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel
										Grid.Column="1"
										Orientation="Horizontal"
										VerticalAlignment="Center">

                                        <Button
											x:Name="PreviousCalendarButton" x:FieldModifier="public"
											Content="‹"
											Width="38"
											Height="34"
											FontSize="18"
											Margin="0,0,6,0"
											ToolTip="Anterior"
											Style="{StaticResource SmallLightButtonStyle}"/>

                                        <Button
											x:Name="TodayCalendarButton" x:FieldModifier="public"
											Content="Hoy"
											Width="70"
											Height="34"
											FontSize="13"
											Margin="0,0,6,0"
											ToolTip="Volver a hoy"
											Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button
											x:Name="NextCalendarButton" x:FieldModifier="public"
											Content="›"
											Width="38"
											Height="34"
											FontSize="18"
											Margin="0,0,14,0"
											ToolTip="Siguiente"
											Style="{StaticResource SmallLightButtonStyle}"/>

                                        <Button
											x:Name="WeekViewButton" x:FieldModifier="public"
											Content="Semana"
											Width="90"
											Height="34"
											FontSize="13"
											Margin="0,0,6,0"
											Style="{StaticResource ActiveFilterButtonStyle}"/>

                                        <Button
											x:Name="MonthViewButton" x:FieldModifier="public"
											Content="Mes"
											Width="70"
											Height="34"
											FontSize="13"
											Style="{StaticResource SecondaryButtonStyle}"/>

                                    </StackPanel>

                                </Grid>

                                <UniformGrid
                                    Grid.Row="1"
                                    Columns="4"
                                    Margin="0,0,0,18">

                                    <Border
                                        Background="#F8FAF6"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14"
                                        Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Hoy" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock x:Name="DashboardTodayCountTextBlock" x:FieldModifier="public" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                            <TextBlock Text="entregas" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Background="#F8FAF6"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14"
                                        Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Próx. 7 días" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock x:Name="DashboardNext7CountTextBlock" x:FieldModifier="public" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                            <TextBlock Text="entregas" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Background="#F8FAF6"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14"
                                        Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Pendientes" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock x:Name="DashboardPendingCountTextBlock" x:FieldModifier="public" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                            <TextBlock Text="sin entregar" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Background="#F8FAF6"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Este mes" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock x:Name="DashboardMonthCountTextBlock" x:FieldModifier="public" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                            <TextBlock Text="entregas" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                </UniformGrid>

                                <StackPanel Grid.Row="2" Margin="0,0,0,14">

                                    <Border
                                        x:Name="UpcomingDeliveriesPanel" x:FieldModifier="public"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="16"
                                        Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="Próximas entregas" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Accesos directos a los próximos trabajos pendientes" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="1"
                                                    Content="Ver mes"
                                                    Width="86"
                                                    Height="32"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="UpcomingDeliveriesMonthButton_Click"/>
                                            </Grid>

                                            <ItemsControl
                                                x:Name="UpcomingDeliveriesItemsControl" x:FieldModifier="public"
                                                ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Width="245"
                                                            MinHeight="92"
                                                            Margin="0,0,10,10"
                                                            Padding="12"
                                                            Background="{Binding CardBackground}"
                                                            BorderBrush="{Binding CardBorderBrush}"
                                                            BorderThickness="{Binding CardBorderThickness}"
                                                            CornerRadius="12"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="UpcomingDeliveryCard_MouseLeftButtonDown">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBlock
                                                                    Text="{Binding DayText}"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource PrimaryBrush}"/>

                                                                <TextBlock
                                                                    Grid.Row="1"
                                                                    Text="{Binding ClientName}"
                                                                    FontSize="14"
                                                                    FontWeight="SemiBold"
                                                                    Margin="0,6,0,0"
                                                                    TextTrimming="CharacterEllipsis"/>

                                                                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                                                                    <Border
                                                                        DockPanel.Dock="Right"
                                                                        Background="{Binding StatusBackground}"
                                                                        CornerRadius="9"
                                                                        Padding="7,3"
                                                                        Margin="8,0,0,0">
                                                                        <TextBlock
                                                                            Text="{Binding StatusLabelText}"
                                                                            FontSize="10"
                                                                            FontWeight="Bold"
                                                                            Foreground="{Binding StatusForeground}"/>
                                                                    </Border>

                                                                    <TextBlock
                                                                        Text="{Binding DisplayTitle}"
                                                                        FontSize="12"
                                                                        Foreground="{StaticResource MutedTextBrush}"
                                                                        TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock
                                                x:Name="UpcomingDeliveriesEmptyTextBlock" x:FieldModifier="public"
                                                Text="No hay próximas entregas pendientes."
                                                FontSize="13"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock
                                        x:Name="EmptyWeekTextBlock" x:FieldModifier="public"
                                        Text="No hay entregas programadas para esta semana."
                                        FontSize="16"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Visibility="Collapsed"/>

                                </StackPanel>

                                <Grid Grid.Row="3">

                                    <!-- VISTA SEMANA EN COLUMNAS -->
                                    <ItemsControl
										x:Name="WeeklyColumnsItemsControl" x:FieldModifier="public"
										ItemsSource="{Binding}"
										Visibility="Visible"
										MouseDoubleClick="CalendarDelivery_MouseDoubleClick">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Background="#F8FAF6"
                                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="14"
                                                    Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock
                                                            Text="{Binding DayTitle}"
                                                            FontSize="16"
                                                            FontWeight="Bold"
                                                            Foreground="{StaticResource PrimaryBrush}"
                                                            Margin="0,0,0,10"/>

                                                        <ItemsControl ItemsSource="{Binding Deliveries}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Background="{Binding CardBackground}"
                                                                        BorderBrush="{Binding CardBorderBrush}"
                                                                        BorderThickness="{Binding CardBorderThickness}"
                                                                        CornerRadius="12"
                                                                        Padding="12"
                                                                        Margin="0,0,0,8"
                                                                        Cursor="Hand"
                                                                        ToolTip="Doble clic para abrir el trabajo">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="110"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock
                                                                                Text="{Binding DayText}"
                                                                                FontSize="12"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                                VerticalAlignment="Center"/>

                                                                            <StackPanel Grid.Column="1" Margin="8,0,16,0">
                                                                                <TextBlock
                                                                                    Text="{Binding ClientName}"
                                                                                    FontSize="15"
                                                                                    FontWeight="{Binding ClientNameWeight}"
                                                                                    TextTrimming="CharacterEllipsis"/>

                                                                                <TextBlock
                                                                                    Text="{Binding DisplayTitle}"
                                                                                    FontSize="13"
                                                                                    Foreground="{StaticResource MutedTextBrush}"
                                                                                    TextTrimming="CharacterEllipsis"
                                                                                    Margin="0,2,0,0"/>

                                                                                <TextBlock
                                                                                    Text="{Binding ClientPhone}"
                                                                                    FontSize="12"
                                                                                    Foreground="{StaticResource MutedTextBrush}"
                                                                                    TextTrimming="CharacterEllipsis"
                                                                                    Margin="0,2,0,0"/>
                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                                <Border
                                                                                    Background="{Binding StatusBackground}"
                                                                                    CornerRadius="10"
                                                                                    Padding="8,3"
                                                                                    HorizontalAlignment="Right">
                                                                                    <TextBlock
                                                                                        Text="{Binding StatusLabelText}"
                                                                                        FontSize="11"
                                                                                        FontWeight="Bold"
                                                                                        Foreground="{Binding StatusForeground}"/>
                                                                                </Border>

                                                                                <TextBlock
                                                                                    Text="{Binding Total, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
                                                                                    FontSize="13"
                                                                                    FontWeight="SemiBold"
                                                                                    Foreground="{StaticResource PrimaryBrush}"
                                                                                    HorizontalAlignment="Right"
                                                                                    Margin="0,5,0,0"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock
                                                            Text="Sin entregas"
                                                            FontSize="12"
                                                            Foreground="{StaticResource MutedTextBrush}"
                                                            FontStyle="Italic"
                                                            Margin="0,4,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasDeliveries}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                    <!-- VISTA MES EN LISTA -->
                                    <ListBox
										x:Name="CalendarGroupsListBox" x:FieldModifier="public"
										BorderThickness="0"
										Background="Transparent"
										Visibility="Collapsed"
										MouseDoubleClick="CalendarDelivery_MouseDoubleClick">

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border
													Background="#F8FAF6"
													BorderBrush="{StaticResource BorderSoftBrush}"
													BorderThickness="1"
													CornerRadius="12"
													Padding="14"
													Margin="0,0,0,12">

                                                    <StackPanel>

                                                        <TextBlock
															Text="{Binding DayTitle}"
															FontSize="16"
															FontWeight="Bold"
															Foreground="{StaticResource PrimaryBrush}"
															Margin="0,0,0,10"/>

                                                        <ItemsControl ItemsSource="{Binding Deliveries}">

                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
																		Background="{Binding CardBackground}"
																		BorderBrush="{Binding CardBorderBrush}"
																		BorderThickness="{Binding CardBorderThickness}"
																		CornerRadius="10"
																		Padding="12"
																		Margin="0,0,0,8"
																		Cursor="Hand"
																		ToolTip="Doble clic para abrir el trabajo">

                                                                        <Grid>

                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="150"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel>

                                                                                <TextBlock
																					Text="{Binding ClientName}"
																					FontSize="15"
																					FontWeight="{Binding ClientNameWeight}"/>

                                                                                <TextBlock
																					Text="{Binding DisplayTitle}"
																					FontSize="13"
																					Foreground="{StaticResource MutedTextBrush}"
																					Margin="0,2,0,0"/>

                                                                                <TextBlock
																					Text="{Binding ClientPhone}"
																					FontSize="12"
																					Foreground="{StaticResource MutedTextBrush}"
																					Margin="0,2,0,0"/>

                                                                            </StackPanel>

                                                                            <StackPanel
																				Grid.Column="1"
																				HorizontalAlignment="Right"
																				VerticalAlignment="Center">

                                                                                <Border
																					Background="{Binding StatusBackground}"
																					CornerRadius="8"
																					Padding="8,3"
																					HorizontalAlignment="Right">

                                                                                    <TextBlock
																						Text="{Binding StatusLabelText}"
																						FontSize="12"
																						FontWeight="Bold"
																						Foreground="{Binding StatusForeground}"/>

                                                                                </Border>

                                                                                <TextBlock
																					Text="{Binding Total, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
																					FontSize="13"
																					Foreground="{StaticResource MutedTextBrush}"
																					HorizontalAlignment="Right"
																					Margin="0,4,0,0"/>

                                                                            </StackPanel>

                                                                        </Grid>

                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>

                                                        </ItemsControl>

                                                    </StackPanel>

                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                </Grid>

                            </Grid>

                        </Border>

                    </Grid>
                </UserControl>
