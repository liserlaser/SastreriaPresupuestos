<UserControl x:Class="SastreriaPresupuestos.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0">
        <Border
            Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="14"
            Padding="22"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Text="ENTREGAS"
                            FontSize="24"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="WeekTitleTextBlock" x:FieldModifier="public"
                            Text="Próximas entregas"
                            FontSize="14"
                            Foreground="{StaticResource MutedTextBrush}"
                            Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Button
                            x:Name="PreviousCalendarButton" x:FieldModifier="public"
                            Content="‹"
                            Width="38"
                            Height="34"
                            FontSize="18"
                            Margin="0,0,6,0"
                            ToolTip="Anterior"
                            Style="{StaticResource SmallLightButtonStyle}"/>

                        <Button
                            x:Name="TodayCalendarButton" x:FieldModifier="public"
                            Content="Hoy"
                            Width="70"
                            Height="34"
                            FontSize="13"
                            Margin="0,0,6,0"
                            ToolTip="Volver a hoy"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                        <Button
                            x:Name="NextCalendarButton" x:FieldModifier="public"
                            Content="›"
                            Width="38"
                            Height="34"
                            FontSize="18"
                            Margin="0,0,14,0"
                            ToolTip="Siguiente"
                            Style="{StaticResource SmallLightButtonStyle}"/>

                        <Button
                            x:Name="ListViewButton" x:FieldModifier="public"
                            Content="Lista"
                            Width="76"
                            Height="34"
                            FontSize="13"
                            Margin="0,0,6,0"
                            Style="{StaticResource ActiveFilterButtonStyle}"/>

                        <Button
                            x:Name="WeekViewButton" x:FieldModifier="public"
                            Content="Semana"
                            Width="90"
                            Height="34"
                            FontSize="13"
                            Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                        <Button
                            x:Name="MonthViewButton" x:FieldModifier="public"
                            Content="Mes"
                            Width="70"
                            Height="34"
                            FontSize="13"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <UniformGrid
                    Grid.Row="1"
                    Columns="4"
                    Margin="0,0,0,18">

                    <Border Background="#F8FAF6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Hoy" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="DashboardTodayCountTextBlock" x:FieldModifier="public" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="entregas" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAF6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Próx. 7 días" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="DashboardNext7CountTextBlock" x:FieldModifier="public" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="entregas" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAF6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Pendientes" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="DashboardPendingCountTextBlock" x:FieldModifier="public" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="sin entregar" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAF6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Este mes" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="DashboardMonthCountTextBlock" x:FieldModifier="public" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="entregas" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <!-- VISTA INICIAL: LISTA DE ENTREGAS -->
                    <ListBox
                        x:Name="DeliveriesListBox" x:FieldModifier="public"
                        AlternationCount="2"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.PanningMode="Both"
                        BorderThickness="0"
                        Background="Transparent"
                        Visibility="Visible"
                        MouseDoubleClick="CalendarDelivery_MouseDoubleClick">

                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="DeliveryListBoxItemStyle"/>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DeliveryCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*" MinWidth="220"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding ClientName}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"/>

                                            <TextBlock
                                                Text="{Binding DisplayTitle}"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Margin="0,2,0,0"
                                                TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding DayText}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Margin="14,0,0,0"
                                            TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock
                                                Text="{Binding Total, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                HorizontalAlignment="Right"/>

                                            <TextBlock
                                                Text="{Binding Deposit, StringFormat=A cuenta {0:N2} €, ConverterCulture=es-ES}"
                                                FontSize="11"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                HorizontalAlignment="Right"
                                                Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border
                                            Grid.Column="3"
                                            Background="{Binding StatusBackground}"
                                            CornerRadius="11"
                                            Padding="10,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="14,0,0,0">
                                            <TextBlock
                                                Text="{Binding StatusLabelText}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{Binding StatusForeground}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- VISTA SEMANA -->
                    <ItemsControl
                        x:Name="WeeklyColumnsItemsControl" x:FieldModifier="public"
                        ItemsSource="{Binding}"
                        Visibility="Collapsed"
                        MouseDoubleClick="CalendarDelivery_MouseDoubleClick">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAF6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DayTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                                        <ItemsControl ItemsSource="{Binding Deliveries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource DeliveryCardBorderStyle}" Padding="12" CornerRadius="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel>
                                                                <TextBlock Text="{Binding ClientName}" FontSize="14" FontWeight="{Binding ClientNameWeight}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding DayText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/>
                                                                <DockPanel Margin="0,6,0,0">
                                                                    <TextBlock Text="{Binding Total, StringFormat={}{0:N2} €, ConverterCulture=es-ES}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right"/>
                                                                    <Border Background="{Binding StatusBackground}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                                                        <TextBlock Text="{Binding StatusLabelText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
                                                                    </Border>
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Sin entregas" FontSize="12" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDeliveries}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- VISTA MES -->
                    <ListBox
                        x:Name="CalendarGroupsListBox" x:FieldModifier="public"
                        AlternationCount="2"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.PanningMode="Both"
                        BorderThickness="0"
                        Background="Transparent"
                        Visibility="Collapsed"
                        MouseDoubleClick="CalendarDelivery_MouseDoubleClick">

                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="DeliveryListBoxItemStyle"/>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAF6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DayTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                                        <ItemsControl ItemsSource="{Binding Deliveries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource DeliveryCardBorderStyle}" Padding="12" CornerRadius="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="150"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel>
                                                                <TextBlock Text="{Binding ClientName}" FontSize="15" FontWeight="{Binding ClientNameWeight}"/>
                                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding ClientPhone}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Border Background="{Binding StatusBackground}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding StatusLabelText}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Total, StringFormat={}{0:N2} €, ConverterCulture=es-ES}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        x:Name="EmptyWeekTextBlock" x:FieldModifier="public"
                        Text="No hay entregas programadas."
                        FontSize="16"
                        Foreground="{StaticResource MutedTextBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
