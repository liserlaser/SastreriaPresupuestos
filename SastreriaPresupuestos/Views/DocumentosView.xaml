<UserControl x:Class="SastreriaPresupuestos.Views.DocumentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="18"
                Padding="20"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PDF DEL TRABAJO"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Exporta el presupuesto, genera la ficha del cliente o prepara el documento para enviar."
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Esta sección pertenece al trabajo seleccionado en la barra superior."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </Grid>

                <Border x:Name="DocumentsEmptyHintBorder"
                        Grid.Row="1"
                        Background="#F8FAF6"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="13"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="DocumentsEmptyHintTextBlock"
                               Text="Selecciona o crea un trabajo con productos antes de exportar PDFs."
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <Border x:Name="DocumentsLastPdfStatusBorder"
                        Grid.Row="2"
                        Background="#F8FAF6"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="13"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Último PDF generado"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="DocumentsLastPdfStatusTextBlock"
                                       Text="Todavía no se ha generado ningún PDF en esta sesión."
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button x:Name="OpenLastPdfButton"
                                Grid.Column="1"
                                Content="Abrir PDF"
                                Height="34"
                                MinWidth="104"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#F8F3EF"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <TextBlock Text="Presupuesto PDF"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Genera el documento principal del trabajo actual con los datos del cliente, productos, importes y notas."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Width="160">
                                <Button Content="Ver PDF"
                                        Height="36"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Ir a la zona PDF del workspace"/>
                                <Button x:Name="ExportPdfButton"
                                        Content="Exportar PDF"
                                        Height="36"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource DarkButtonStyle}"
                                        ToolTip="Generar el PDF del trabajo actual"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Background="#FAF8F5"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Ficha cliente"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Genera la ficha con datos de cliente y resumen del trabajo. El DNI se mantiene solo para documentos."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,14"/>
                                <Button x:Name="ExportClientSheetButton"
                                        Content="Generar ficha"
                                        Click="ExportClientSheetButton_Click"
                                        Height="36"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FAF8F5"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Todos los trabajos"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Exporta en un único PDF todos los trabajos asociados al cliente seleccionado."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,14"/>
                                <Button x:Name="ExportAllQuotesPdfButton"
                                        Content="Exportar todos"
                                        Height="36"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
