<UserControl x:Class="SastreriaPresupuestos.Views.DocumentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                    <Grid Margin="0,0,0,0">

                        <Border
							Background="{StaticResource CardBackgroundBrush}"
							CornerRadius="14"
							Padding="22"
							BorderBrush="{StaticResource BorderSoftBrush}"
							BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,24">

                                    <TextBlock
										Text="PDF"
										FontSize="24"
										FontWeight="Bold"/>

                                    <TextBlock
										Text="Genera PDFs y fichas para enviar o imprimir."
										FontSize="14"
										Foreground="{StaticResource MutedTextBrush}"
										Margin="0,4,0,0"/>

                                    <Border
										x:Name="DocumentsEmptyHintBorder"
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="10"
										Padding="12"
										Margin="0,12,0,0"
										Visibility="Collapsed">

                                        <TextBlock
											x:Name="DocumentsEmptyHintTextBlock"
											Text="Selecciona o crea un trabajo con productos antes de exportar PDFs."
											FontSize="13"
											Foreground="{StaticResource MutedTextBrush}"
											TextWrapping="Wrap"/>

                                    </Border>

                                </StackPanel>

                                <WrapPanel
									Grid.Row="1"
									ItemWidth="260">


                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16">

                                        <StackPanel>

                                            <TextBlock
												Text="PDF actual"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Exporta el trabajo abierto."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>
                                            <Button
												x:Name="ExportPdfButton"
												Content="Exportar PDF"
												Height="40"
												FontSize="15"
                                                HorizontalAlignment="Stretch"
												Style="{StaticResource DarkButtonStyle}"/>

                                            <Button
												x:Name="ExportClientSheetButton"
												Content="Exportar ficha cliente"
												Click="ExportClientSheetButton_Click"
                                                HorizontalAlignment="Stretch"
												Style="{StaticResource SecondaryButtonStyle}"
												Margin="0,10,0,0"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16">

                                        <StackPanel>

                                            <TextBlock
												Text="PDF opciones"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Exporta todos los trabajos del cliente."
												FontSize="13"
                                                HorizontalAlignment="Stretch"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,14,0,14"/>

                                            <Button
												x:Name="ExportAllQuotesPdfButton"
												Content="Exportar Opciones"
												Height="40"
												FontSize="15"
												Style="{StaticResource DarkButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16"
										Opacity="0.65">

                                        <StackPanel>

                                            <TextBlock
												Text="Imagen WhatsApp"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Pendiente: imagen vertical para enviar rápido."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>

                                            <Button
												Content="Próximamente"
												Height="40"
												FontSize="15"
												IsEnabled="False"
												Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16"
										Opacity="0.65">

                                        <StackPanel>

                                            <TextBlock
												Text="Editable"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Pendiente: DOCX/XLSX compatible."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>

                                            <Button
												Content="Próximamente"
												Height="40"
												FontSize="15"
												IsEnabled="False"
												Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                </WrapPanel>

                            </Grid>

                        </Border>

                    </Grid>
                </UserControl>
