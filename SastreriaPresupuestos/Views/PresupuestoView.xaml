<UserControl x:Class="SastreriaPresupuestos.Views.PresupuestoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <UserControl.Resources>
        <x:Array Type="{x:Type sys:String}" x:Key="QuoteStatusList">
            <sys:String>Pendiente</sys:String>
            <sys:String>Aceptado</sys:String>
            <sys:String>Rechazado</sys:String>
            <sys:String>Entregado</sys:String>
        </x:Array>
    </UserControl.Resources>
                    <ScrollViewer
						VerticalScrollBarVisibility="Auto"
						HorizontalScrollBarVisibility="Disabled">

                        <Grid Margin="0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="16"
                                Padding="18"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,14">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock
                                            Text="PRESUPUESTO ACTIVO"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource AccentBrush}"/>

                                        <TextBlock
                                            x:Name="BudgetWorkspaceTitleTextBlock"
                                            Text="Sin presupuesto seleccionado"
                                            FontSize="24"
                                            FontWeight="Bold"
                                            Margin="0,4,0,0"
                                            TextTrimming="CharacterEllipsis"/>

                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBlock
                                                x:Name="BudgetWorkspaceClientTextBlock"
                                                Text="Cliente: —"
                                                FontSize="13"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Margin="0,0,18,0"/>
                                            <TextBlock
                                                x:Name="BudgetWorkspaceStatusTextBlock"
                                                Text="Estado: —"
                                                FontSize="13"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Margin="0,0,18,0"/>
                                            <TextBlock
                                                x:Name="BudgetWorkspaceDeliveryTextBlock"
                                                Text="Entrega: —"
                                                FontSize="13"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Margin="0,0,18,0"/>
                                            <TextBlock
                                                x:Name="BudgetWorkspaceTotalTextBlock"
                                                Text="Total: 0,00 €"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource PrimaryBrush}"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="24,0,0,0">

                                        <Button
                                            x:Name="BudgetQuickExportPdfButton"
                                            Content="PDF"
                                            Width="92"
                                            Height="38"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button
                                            x:Name="BudgetQuickDocumentsButton"
                                            Content="Documentos"
                                            Width="126"
                                            Height="38"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
								x:Name="PresupuestoEmptyHintBorder"
								Grid.Row="0"
								Background="#F8FAF6"
								BorderBrush="{StaticResource BorderSoftBrush}"
								BorderThickness="1"
								CornerRadius="10"
								Padding="14"
								Margin="0,112,0,14"
								Visibility="Collapsed">

                                <TextBlock
									Text="Selecciona un cliente en la pestaña Clientes o crea uno nuevo para empezar un presupuesto."
									FontSize="14"
									Foreground="{StaticResource MutedTextBrush}"
									TextWrapping="Wrap"/>

                            </Border>

                            <!-- DATOS DEL CLIENTE -->
                            <Border
								Grid.Row="1"
								Background="{StaticResource CardBackgroundBrush}"
								CornerRadius="14"
								Padding="22"
								BorderBrush="{StaticResource BorderSoftBrush}"
								BorderThickness="1"
								Margin="0,0,0,18">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
										Grid.Row="0"
										Grid.Column="0"
										Grid.ColumnSpan="4"
										Text="DATOS DEL CLIENTE"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{StaticResource AccentBrush}"
										Margin="0,0,0,12"/>

                                    <!-- Nombre -->
                                    <TextBlock
										Grid.Row="1"
										Grid.Column="0"
										Text="Cliente:"
										FontSize="14"
										VerticalAlignment="Center"
										FontWeight="SemiBold"
										Margin="20,0,0,0"/>

                                    <TextBox
										Grid.Row="1"
										Grid.Column="1"
										Margin="10,10,10,10"
										Height="35"
										FontSize="16"
										x:Name="ClientNameTextBox"/>

                                    <!-- Teléfono -->
                                    <TextBlock
										Grid.Row="1"
										Grid.Column="2"
										Text="Teléfono:"
										FontSize="14"
										VerticalAlignment="Center"
										FontWeight="SemiBold"
										Margin="20,0,0,0"/>

                                    <TextBox
										Grid.Row="1"
										Grid.Column="3"
										Margin="10,10,10,10"
										Height="35"
										FontSize="16"
										x:Name="PhoneTextBox"/>

                                    <!-- DNI -->
                                    <TextBlock
										Grid.Row="2"
										Grid.Column="0"
										Text="DNI:"
										FontSize="14"
										VerticalAlignment="Center"
										FontWeight="SemiBold"
										Margin="20,0,0,0"/>

                                    <TextBox
										Grid.Row="2"
										Grid.Column="1"
										Margin="10,10,10,10"
										Height="35"
										FontSize="16"
										x:Name="DniTextBox"/>

                                    <Button
										x:Name="SaveClientButton"
										Grid.Row="2"
										Grid.Column="3"
										Content="Guardar Cliente"
										Height="38"
										Margin="10,10,10,10"
										FontSize="14"
										ToolTip="Guardar nombre, teléfono y DNI del cliente"
										Style="{StaticResource SecondaryButtonStyle}"/>

                                </Grid>
                            </Border>

                            <!-- DATOS DEL PRESUPUESTO -->
                            <Border
								Grid.Row="2"
								Background="{StaticResource CardBackgroundBrush}"
								CornerRadius="14"
								Padding="22"
								BorderBrush="{StaticResource BorderSoftBrush}"
								BorderThickness="1"
								Margin="0,0,0,18">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock
										Grid.Row="0"
										Grid.Column="0"
										Grid.ColumnSpan="4"
										Text="DATOS DEL PRESUPUESTO"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{StaticResource AccentBrush}"
										Margin="0,0,0,12"/>

                                    <!-- Fechas -->
                                    <TextBlock
										Grid.Row="1"
										Grid.Column="0"
										Text="Entrega:"
										FontSize="14"
										VerticalAlignment="Center"
										FontWeight="SemiBold"
										Margin="20,0,0,0"/>

                                    <DatePicker
										x:Name="DeliveryDatePicker"
										Grid.Row="1"
										Grid.Column="1"
										Margin="10,10,10,10"
										Height="35"
										SelectedDate="{x:Static sys:DateTime.Now}"/>

                                    <TextBlock
										Grid.Row="1"
										Grid.Column="2"
										Text="Fecha evento:"
										FontSize="14"
										VerticalAlignment="Center"
										FontWeight="SemiBold"
										Margin="20,0,0,0"/>

                                    <DatePicker
										Grid.Row="1"
										Grid.Column="3"
										x:Name="EventDatePicker"
										Height="35"
										FontSize="15"
										Margin="10,10,10,10"/>

                                    <!-- Título y estado -->
                                    <TextBlock
										Grid.Row="2"
										Grid.Column="0"
										Text="Presupuesto:"
										FontSize="14"
										VerticalAlignment="Center"
										FontWeight="SemiBold"
										Margin="20,0,0,0"/>

                                    <Grid
										Grid.Row="2"
										Grid.Column="1"
										Margin="10,10,10,10">

                                        <TextBox
											x:Name="QuoteTitleTextBox"
											Height="35"
											FontSize="16"/>

                                        <TextBlock
											x:Name="QuoteTitlePlaceholderTextBlock"
											Text="Ej. Traje novio, Chaqué medida..."
											Foreground="{StaticResource MutedTextBrush}"
											Margin="10,0,0,0"
											VerticalAlignment="Center"
											IsHitTestVisible="False"/>

                                    </Grid>

                                    <TextBlock
										Grid.Row="2"
										Grid.Column="2"
										Text="Estado:"
										FontSize="14"
										VerticalAlignment="Center"
										FontWeight="SemiBold"
										Margin="20,0,0,0"/>

                                    <ComboBox
										x:Name="QuoteStatusComboBox"
										Grid.Row="2"
										Grid.Column="3"
										Margin="10,10,10,10"
										Height="35"
										FontSize="14"
										ItemsSource="{StaticResource QuoteStatusList}"
										SelectedItem="Pendiente"/>

                                    <!-- Importes -->
                                    <TextBlock
										Grid.Row="3"
										Grid.Column="0"
										Text="A Cuenta:"
										FontSize="14"
										VerticalAlignment="Center"
										FontWeight="SemiBold"
										Margin="20,0,0,0"/>

                                    <TextBox
										x:Name="DepositTextBox"
										Grid.Row="3"
										Grid.Column="1"
										Margin="10,10,10,10"
										Height="35"
										FontSize="14"
										Text="0"
										HorizontalContentAlignment="Right"/>

                                    <TextBlock
										Grid.Row="3"
										Grid.Column="2"
										Text="Pendiente:"
										FontSize="14"
										VerticalAlignment="Center"
										FontWeight="SemiBold"
										Margin="20,0,0,0"/>

                                    <TextBlock
										x:Name="PendingAmountTextBlock"
										Grid.Row="3"
										Grid.Column="3"
										Margin="10,0,10,0"
										VerticalAlignment="Center"
										FontSize="18"
										FontWeight="Bold"
										Text="0,00 €"/>

                                    <!-- Notas internas -->
                                    <TextBlock
										Grid.Row="4"
										Grid.Column="0"
										Text="Notas internas:"
										FontSize="14"
										VerticalAlignment="Top"
										FontWeight="SemiBold"
										Margin="20,20,0,0"/>

                                    <Grid
										Grid.Row="4"
										Grid.Column="1"
										Grid.ColumnSpan="3"
										Margin="10">

                                        <TextBox
											x:Name="QuoteNotesTextBox"
											Height="70"
											FontSize="14"
											TextWrapping="Wrap"
											AcceptsReturn="True"
											VerticalScrollBarVisibility="Auto"/>

                                        <TextBlock
											x:Name="QuoteNotesPlaceholderTextBlock"
											Text="Notas internas, ajustes, preferencias del cliente..."
											Foreground="{StaticResource MutedTextBrush}"
											Margin="10,8,10,0"
											VerticalAlignment="Top"
											IsHitTestVisible="False"/>

                                    </Grid>

                                    <!-- Notas cliente -->
                                    <TextBlock
										Grid.Row="5"
										Grid.Column="0"
										Text="Notas cliente:"
										FontSize="14"
										VerticalAlignment="Top"
										FontWeight="SemiBold"
										Margin="20,20,0,0"/>

                                    <Grid
										Grid.Row="5"
										Grid.Column="1"
										Grid.ColumnSpan="3"
										Margin="10">

                                        <TextBox
											x:Name="ClientNotesTextBox"
											Height="60"
											FontSize="14"
											TextWrapping="Wrap"
											AcceptsReturn="True"
											VerticalScrollBarVisibility="Auto"/>

                                        <TextBlock
											x:Name="ClientNotesPlaceholderTextBlock"
											Text="Texto visible para el cliente en el PDF..."
											Foreground="{StaticResource MutedTextBrush}"
											Margin="10,8,10,0"
											VerticalAlignment="Top"
											IsHitTestVisible="False"/>

                                    </Grid>

                                </Grid>
                            </Border>

                            <!-- PRESUPUESTOS Y ACCIONES -->
                            <Grid
								Grid.Row="3"
								Margin="0,4,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tarjetas compactas de presupuestos -->
                                <ListBox
									x:Name="BudgetQuotesListBox"
									Grid.Column="0"
									HorizontalContentAlignment="Stretch"
									BorderThickness="0"
									Background="Transparent"
									MaxHeight="78"
									ScrollViewer.HorizontalScrollBarVisibility="Auto"
									ScrollViewer.VerticalScrollBarVisibility="Disabled"
									SelectionChanged="BudgetQuotesListBox_SelectionChanged"
									MouseDoubleClick="BudgetQuotesListBox_MouseDoubleClick"
									ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border
					Width="210"
					Height="70"
					Background="{Binding CardBackground}"
					BorderBrush="{Binding CardBorderBrush}"
					BorderThickness="{Binding CardBorderThickness}"
					CornerRadius="10"
					Padding="9"
					Margin="0,0,8,0"
					ToolTip="Presupuesto del cliente">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Text="{Binding DisplayTitle}"
							FontSize="12"
							FontWeight="{Binding TitleWeight}"
							TextTrimming="CharacterEllipsis"/>

                                                    <Border
							Grid.Row="0"
							Grid.Column="1"
							Background="{Binding StatusBackground}"
							CornerRadius="7"
							Padding="6,2"
							Margin="6,0,0,0">

                                                        <TextBlock
								Text="{Binding StatusLabelText}"
								FontSize="8"
								FontWeight="Bold"
								Foreground="{Binding StatusForeground}"/>
                                                    </Border>

                                                    <TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							Text="{Binding DeliveryDate, StringFormat=Entrega: {0:dd/MM/yyyy}}"
							FontSize="10"
							Foreground="{StaticResource MutedTextBrush}"
							Margin="0,3,0,0"/>

                                                    <TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							Text="{Binding Total, StringFormat=Total: {0:N2} €, ConverterCulture=es-ES}"
							FontSize="11"
							FontWeight="SemiBold"
							Foreground="{StaticResource PrimaryBrush}"
							Margin="0,3,0,0"/>

                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Botones -->
                                <StackPanel
		Grid.Column="1"
		Orientation="Horizontal"
		HorizontalAlignment="Right"
		VerticalAlignment="Bottom"
		Margin="14,0,0,0">

                                    <TextBlock
			x:Name="UnsavedChangesTextBlock"
			Text="Cambios sin guardar"
			VerticalAlignment="Center"
			FontWeight="SemiBold"
			Foreground="{StaticResource AccentBrush}"
			Margin="0,0,18,0"
			Visibility="Collapsed"/>

                                    <Button
			x:Name="NewQuoteButton"
			Content="Nuevo Presupuesto"
			Width="180"
			Height="45"
			Margin="0,0,10,0"
			FontSize="16"
			Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button
			x:Name="DuplicateQuoteButton"
			Content="Duplicar Presupuesto"
			Width="180"
			Height="45"
			Margin="0,0,10,0"
			FontSize="16"
			Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button
										x:Name="SaveButton"
										Content="Guardar"
										Width="140"
										Height="45"
										FontSize="16"
										Style="{StaticResource PrimaryActionButtonStyle}"/>

                                </StackPanel>

                            </Grid>

                        </Grid>
                    </ScrollViewer>
</UserControl>
