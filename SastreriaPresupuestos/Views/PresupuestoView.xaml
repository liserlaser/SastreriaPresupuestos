<UserControl x:Class="SastreriaPresupuestos.Views.PresupuestoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <UserControl.Resources>
        <x:Array Type="{x:Type sys:String}" x:Key="QuoteStatusList">
            <sys:String>Pendiente</sys:String>
            <sys:String>Aceptado</sys:String>
            <sys:String>Rechazado</sys:String>
            <sys:String>Entregado</sys:String>
        </x:Array>

        <Style x:Key="ContextLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ContextTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFCFA"/>
        </Style>

        <Style x:Key="ContextDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2B2520"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFCFA"/>
        </Style>

        <Style x:Key="JobListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="14"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2EA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E7EDE2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CONTEXT BAR CLIENTE | TRABAJO -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="18"
                Padding="12"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>

                <!-- Cliente -->
                <Grid Grid.Column="0" Margin="0,0,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="CLIENTE"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   DockPanel.Dock="Left"/>
                        
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Nombre" 
                                       Style="{StaticResource ContextLabelTextStyle}"/>
                            <Grid>
                                <!-- Se mantiene el TextBox oculto porque centraliza la lógica existente de guardado/autoguardado. -->
                                <TextBox x:Name="ClientNameTextBox"
                                         Visibility="Collapsed"/>
                                <TextBlock Text="{Binding Text, ElementName=ClientNameTextBox, TargetNullValue=—, FallbackValue=—}"
                                           Height="34"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#2B2520"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,0,0">
                            <TextBlock Text="Teléfono" 
                                       Style="{StaticResource ContextLabelTextStyle}"/>
                            <Grid>
                                <TextBox x:Name="PhoneTextBox"
                                         Visibility="Collapsed"/>
                                <TextBlock x:Name="PhoneDisplayTextBlock"
                                           Text="—"
                                           Height="34"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#2B2520"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>

                        <!-- El DNI se mantiene oculto para la lógica de ficha/PDF, pero ya no se muestra en la Context Bar. -->
                        <TextBox x:Name="DniTextBox" Visibility="Collapsed"/>
                        
                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="14,0,0,0">
                            <Button x:Name="SaveClientButton"
                                    Content="Editar"
                                    Width="70"
                                    Height="30"
                                    Margin="0,0,0,6"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Editar los datos del cliente"/>
                            <Button x:Name="ClientSheetButton"
                                    Content="Ficha"
                                    Width="70"
                                    Height="30"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Generar la ficha interna del cliente"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Column="1"
                        Width="1"
                        Background="{StaticResource BorderSoftBrush}"
                        Margin="0,2"
                        Opacity="0.95"/>

                <!-- Trabajo -->
                <Grid Grid.Column="2" Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="TRABAJO"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right">
                            <TextBlock x:Name="UnsavedChangesTextBlock"
                                       Text="Cambios sin guardar"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,12,0"
                                       Visibility="Collapsed"/>
                            <Button x:Name="EditJobButton"
                                    Content="Editar"
                                    Width="78"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Editar los datos principales del trabajo"/>
                            <Button x:Name="SaveButton"
                                    Content="Guardar"
                                    Width="86"
                                    Height="32"
                                    Visibility="Collapsed"
                                    Style="{StaticResource PrimaryActionButtonStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Título" Style="{StaticResource ContextLabelTextStyle}"/>
                            <Grid>
                                <TextBox x:Name="QuoteTitleTextBox" Style="{StaticResource ContextTextBoxStyle}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontWeight="SemiBold" Cursor="Arrow"/>
                                <TextBlock x:Name="QuoteTitlePlaceholderTextBlock"
                                           Text="Ej. Traje novio, chaqué..."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Estado" Style="{StaticResource ContextLabelTextStyle}"/>
                            <Grid Height="34">
                                <ComboBox x:Name="QuoteStatusComboBox"
                                          Visibility="Collapsed"
                                          ItemsSource="{StaticResource QuoteStatusList}"
                                          SelectedItem="Pendiente"/>
                                <Border x:Name="QuoteStatusBadgeBorder"
                                        CornerRadius="9"
                                        Padding="10,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#EEF2EA">
                                    <TextBlock x:Name="QuoteStatusBadgeTextBlock"
                                               Text="PENDIENTE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#2F332D"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Evento" Style="{StaticResource ContextLabelTextStyle}"/>
                            <Grid>
                                <DatePicker x:Name="DeliveryDatePicker"
                                            Visibility="Collapsed"
                                            SelectedDate="{x:Static sys:DateTime.Now}"/>
                                <TextBlock x:Name="EventDateDisplayTextBlock"
                                           Text="—"
                                           Height="34"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#2B2520"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- WORKSPACE CONTEXTUAL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="360"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de trabajos -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="18"
                    Padding="14"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Trabajos"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Selecciona un trabajo para cargar su contexto"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Búsqueda interna desactivada: se mantiene oculta para no romper referencias existentes. -->
                        <TextBox x:Name="WorkSearchTextBox" Visibility="Collapsed"/>
                        <TextBlock x:Name="WorkSearchPlaceholderTextBlock" Visibility="Collapsed"/>
                    </Grid>

                    <ListBox x:Name="BudgetQuotesListBox"
                             Grid.Row="1"
                             HorizontalContentAlignment="Stretch"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.PanningMode="VerticalOnly"
                             SelectionChanged="BudgetQuotesListBox_SelectionChanged"
                             MouseDoubleClick="BudgetQuotesListBox_MouseDoubleClick"
                             ItemContainerStyle="{StaticResource JobListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="{Binding CardBackground}"
                                    BorderBrush="{Binding CardBorderBrush}"
                                    BorderThickness="{Binding CardBorderThickness}"
                                    CornerRadius="14"
                                    Padding="14,12"
                                    Margin="0,0,0,8"
		                            ToolTip="Doble clic para abrir el trabajo">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- 1. Fecha + título -->
                                            <ColumnDefinition Width="1.4*"/>

                                            <!-- 2. Total / A cuenta / Pendiente -->
                                            <ColumnDefinition Width="1.4*"/>

                                            <!-- 3. Estado -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Fecha evento + título -->
                                        <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Margin="0,0,0,0">

                                            <TextBlock
                    Text="{Binding EventDateText}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource MutedTextBrush}"/>

                                            <TextBlock
                    Text="{Binding DisplayTitle}"
                    FontSize="12"
                    FontWeight="{Binding TitleWeight}"
                    Foreground="{StaticResource PrimaryBrush}"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    MaxHeight="40"
                    Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Importes -->
                                        <StackPanel Grid.Column="1"
												VerticalAlignment="Center"
												Margin="0,0,18,0">
                                            <TextBlock Text="Total"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Total, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Deposit, StringFormat=A cuenta · {0:N2} €, ConverterCulture=es-ES}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PendingPaymentText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding PendingPaymentForeground}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Estado -->
                                        <Border
                Grid.Column="2"
                Background="{Binding StatusBackground}"
                CornerRadius="10"
                Padding="10,5"
                MinWidth="70"
                VerticalAlignment="Center">

                                            <TextBlock
                    Text="{Binding StatusLabelText}"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="{Binding StatusForeground}"
                    TextAlignment="Center"
                    VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button x:Name="NewQuoteButton"
                                Content="＋ Crear presupuesto"
                                Height="40"
                                FontSize="14"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>
                        <Button x:Name="DuplicateQuoteButton"
                                Content="Duplicar trabajo"
                                Height="36"
                                FontSize="13"
                                Margin="0,8,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detalle del trabajo -->
            <ScrollViewer x:Name="WorkspaceScrollViewer"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Visibility="Collapsed">
                        <TextBlock x:Name="BudgetWorkspaceTitleTextBlock" Text="Sin trabajo seleccionado"/>
                        <TextBlock x:Name="BudgetWorkspaceClientTextBlock" Text="Cliente: —"/>
                        <TextBlock x:Name="BudgetWorkspaceStatusTextBlock" Text="Estado: —"/>
                        <TextBlock x:Name="BudgetWorkspaceDeliveryTextBlock" Text="Entrega: —"/>
                        <TextBlock x:Name="BudgetWorkspaceTotalTextBlock" Text="0,00 €"/>
                        <Button x:Name="BudgetQuickSummaryButton"/>
                        <Button x:Name="BudgetQuickProductsButton"/>
                        <Button x:Name="BudgetQuickHistoryButton"/>
                        <Button x:Name="BudgetQuickDocumentsButton"/>
                        <Button x:Name="BudgetQuickExportPdfButton"/>
                    </StackPanel>

                    <Border x:Name="PresupuestoEmptyHintBorder"
                            Grid.Row="0"
                            Background="#F8FAF6"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">
                        <TextBlock Text="Selecciona un trabajo o crea uno nuevo para empezar."
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="0"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1">
                        <TabControl x:Name="PresupuestoWorkspaceTabs"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    SelectedIndex="0">

                            <TabItem Header="Resumen">
                                <Grid Margin="18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.45*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Título" Style="{StaticResource ContextLabelTextStyle}"/>
                                            <TextBox x:Name="WorkspaceQuoteTitleTextBox"
                                                     Style="{StaticResource ContextTextBoxStyle}"
                                                     Text="{Binding Text, ElementName=QuoteTitleTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Productos" Style="{StaticResource ContextLabelTextStyle}"/>
                                            <Border Height="34"
                                                    Background="#FBFCFA"
                                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,0">
                                                <TextBlock x:Name="WorkspaceProductCountTextBlock"
                                                           Text="0 productos"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Fecha evento" Style="{StaticResource ContextLabelTextStyle}"/>
                                            <DatePicker x:Name="EventDatePicker" Style="{StaticResource ContextDatePickerStyle}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Fecha entrega" Style="{StaticResource ContextLabelTextStyle}"/>
                                            <DatePicker x:Name="WorkspaceDeliveryDatePicker"
                                                        Style="{StaticResource ContextDatePickerStyle}"
                                                        SelectedDate="{Binding SelectedDate, ElementName=DeliveryDatePicker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="4">
                                        <TextBlock Text="A cuenta" Style="{StaticResource ContextLabelTextStyle}"/>
                                        <TextBox x:Name="DepositTextBox"
                                                 Style="{StaticResource ContextTextBoxStyle}"
                                                 Text="0"
                                                 HorizontalContentAlignment="Right"/>
                                    </StackPanel>

                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Total" Style="{StaticResource ContextLabelTextStyle}"/>
                                            <Border MinHeight="42"
                                                    Background="#FBFCFA"
                                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,0">
                                                <TextBlock Text="{Binding Text, ElementName=BudgetWorkspaceTotalTextBlock}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           TextTrimming="None"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Pendiente" Style="{StaticResource ContextLabelTextStyle}"/>
                                            <Border MinHeight="42"
                                                    Background="#FBFCFA"
                                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,0">
                                                <TextBlock x:Name="PendingAmountTextBlock"
                                                           Text="0,00 €"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           TextTrimming="None"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="8"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="Creado "
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="QuoteCreatedAtTextBox"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="—"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Notas">
                                <Grid Margin="18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#F8F3EF"
                                            BorderBrush="{StaticResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Notas internas"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,0,0,10"/>
                                            <Grid Grid.Row="1">
                                                <TextBox x:Name="QuoteNotesTextBox"
                                                         MinHeight="140"
                                                         FontSize="14"
                                                         Padding="10,8"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"/>
                                                <TextBlock x:Name="QuoteNotesPlaceholderTextBlock"
                                                           Text="Notas internas, ajustes, preferencias del cliente..."
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="10,8,10,0"
                                                           VerticalAlignment="Top"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2"
                                            Background="#FAF8F5"
                                            BorderBrush="{StaticResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Notas cliente / PDF"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,0,0,10"/>
                                            <Grid Grid.Row="1">
                                                <TextBox x:Name="ClientNotesTextBox"
                                                         MinHeight="120"
                                                         FontSize="14"
                                                         Padding="10,8"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"/>
                                                <TextBlock x:Name="ClientNotesPlaceholderTextBlock"
                                                           Text="Texto visible para el cliente en el PDF..."
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="10,8,10,0"
                                                           VerticalAlignment="Top"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Documentos">
                                <Grid Margin="18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border x:Name="DocumentsEmptyHintBorder"
                                            Grid.Row="0"
                                            Background="#F8FAF6"
                                            BorderBrush="{StaticResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="13"
                                            Margin="0,0,0,14"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="DocumentsEmptyHintTextBlock"
                                                   Text="Selecciona o crea un trabajo con productos antes de exportar PDFs."
                                                   FontSize="13"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <Border x:Name="DocumentsLastPdfStatusBorder"
                                            Grid.Row="1"
                                            Background="#F8FAF6"
                                            BorderBrush="{StaticResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="13"
                                            Margin="0,0,0,14"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock Text="Último documento generado"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock x:Name="DocumentsLastPdfStatusTextBlock"
                                                           Text="Todavía no se ha generado ningún documento en esta sesión."
                                                           FontSize="13"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="OpenLastPdfButton"
                                                    Grid.Column="1"
                                                    Content="Abrir último"
                                                    Height="34"
                                                    MinWidth="112"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryButtonStyle}"/>
                                        </Grid>
                                    </Border>

                                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,14">
                                        <Border Background="#F8F3EF" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="Ficha cliente" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="Genera la ficha interna del cliente y abre la carpeta configurada."
                                                           FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                                <Button x:Name="ExportClientSheetButton" Content="Generar ficha" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="ExportClientSheetButton_Click"/>
                                                <Button x:Name="OpenClientSheetFolderButton" Content="Abrir ficha cliente" Height="34" Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#F8F3EF" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="5,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="PDF presupuesto" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="Genera el PDF principal del trabajo o abre la carpeta de presupuestos."
                                                           FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                                <Button x:Name="ExportPdfButton" Content="Generar PDF" Height="36" Style="{StaticResource DarkButtonStyle}"/>
                                                <Button x:Name="OpenQuoteFolderButton" Content="Abrir presupuestos" Height="34" Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#FAF8F5" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="10,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="PDF opciones" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="Exporta todos los trabajos del cliente en un único documento comparativo."
                                                           FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                                <Button x:Name="ExportAllQuotesPdfButton" Content="Generar PDF opciones" Height="36" Style="{StaticResource SecondaryButtonStyle}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Grid.Row="3"
                                            Background="#FAF8F5"
                                            BorderBrush="{StaticResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Factura"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="Botones preparados para la integración futura de facturación."
                                                           FontSize="13"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Button x:Name="CreateInvoiceButton" Content="Crear factura" Height="36" MinWidth="118" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                                <Button x:Name="ViewInvoiceButton" Content="Ver factura" Height="36" MinWidth="104" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Historial">
                                <Border x:Name="ActivityTimelineBorder"
                                        Margin="18"
                                        Background="#FAF8F5"
                                        CornerRadius="18"
                                        Padding="18"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="HISTORIAL"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,0,12"/>
                                        <Border Background="#F8F3EF" CornerRadius="12" Padding="11" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Implementación futura" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="Aquí se mostrará la actividad real del trabajo: creación, cambios, documentos y facturación." FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F8F3EF" CornerRadius="12" Padding="11" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Trabajo creado" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="Datos base del cliente y del trabajo disponibles" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#FAF8F5" CornerRadius="12" Padding="11" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Productos preparados" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="Accede a Productos para completar el presupuesto" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F8F3EF" CornerRadius="12" Padding="11">
                                            <StackPanel>
                                                <TextBlock Text="PDF pendiente" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="Genera el documento cuando productos y notas estén completos" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
