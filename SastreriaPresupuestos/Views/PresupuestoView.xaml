<UserControl x:Class="SastreriaPresupuestos.Views.PresupuestoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <UserControl.Resources>
        <x:Array Type="{x:Type sys:String}" x:Key="QuoteStatusList">
            <sys:String>Pendiente</sys:String>
            <sys:String>Aceptado</sys:String>
            <sys:String>Rechazado</sys:String>
            <sys:String>Entregado</sys:String>
        </x:Array>

        <Style x:Key="ContextLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ContextTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFCFA"/>
        </Style>

        <Style x:Key="ContextDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFCFA"/>
        </Style>

        <Style x:Key="JobListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="14"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2EA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E7EDE2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CONTEXT BAR CLIENTE | TRABAJO -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="18"
                Padding="14"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1.28*"/>
                </Grid.ColumnDefinitions>

                <!-- Cliente -->
                <Grid Grid.Column="0" Margin="0,0,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="CLIENTE"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right">
                            <Button x:Name="SaveClientButton"
                                    Content="Editar"
                                    Width="78"
                                    Height="32"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Editar los datos del cliente"/>
                            <Button x:Name="ClientSheetButton"
                                    Content="Ficha"
                                    Width="78"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Generar la ficha interna del cliente"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Nombre" Style="{StaticResource ContextLabelTextStyle}"/>
                            <TextBox x:Name="ClientNameTextBox" Style="{StaticResource ContextTextBoxStyle}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontWeight="SemiBold" Cursor="Arrow"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Teléfono" Style="{StaticResource ContextLabelTextStyle}"/>
                            <TextBox x:Name="PhoneTextBox" Style="{StaticResource ContextTextBoxStyle}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontWeight="SemiBold" Cursor="Arrow"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DNI" Style="{StaticResource ContextLabelTextStyle}"/>
                            <TextBox x:Name="DniTextBox" Style="{StaticResource ContextTextBoxStyle}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontWeight="SemiBold" Cursor="Arrow"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Column="1"
                        Width="1"
                        Background="{StaticResource BorderSoftBrush}"
                        Margin="0,2"
                        Opacity="0.95"/>

                <!-- Trabajo -->
                <Grid Grid.Column="2" Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="TRABAJO"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right">
                            <TextBlock x:Name="UnsavedChangesTextBlock"
                                       Text="Cambios sin guardar"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,12,0"
                                       Visibility="Collapsed"/>
                            <Button x:Name="EditJobButton"
                                    Content="Editar"
                                    Width="78"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Editar los datos principales del trabajo"/>
                            <Button x:Name="SaveButton"
                                    Content="Guardar"
                                    Width="86"
                                    Height="32"
                                    Style="{StaticResource PrimaryActionButtonStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Título" Style="{StaticResource ContextLabelTextStyle}"/>
                            <Grid>
                                <TextBox x:Name="QuoteTitleTextBox" Style="{StaticResource ContextTextBoxStyle}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontWeight="SemiBold" Cursor="Arrow"/>
                                <TextBlock x:Name="QuoteTitlePlaceholderTextBlock"
                                           Text="Ej. Traje novio, chaqué..."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Estado" Style="{StaticResource ContextLabelTextStyle}"/>
                            <ComboBox x:Name="QuoteStatusComboBox"
                                      Height="34"
                                      FontSize="14"
                                      ItemsSource="{StaticResource QuoteStatusList}"
                                      SelectedItem="Pendiente"
                                      IsHitTestVisible="False"
                                      Focusable="False"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Entrega" Style="{StaticResource ContextLabelTextStyle}"/>
                            <DatePicker x:Name="DeliveryDatePicker"
                                        Style="{StaticResource ContextDatePickerStyle}"
                                        SelectedDate="{x:Static sys:DateTime.Now}"
                                        IsHitTestVisible="False"
                                        Focusable="False"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- WORKSPACE CONTEXTUAL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="360"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de trabajos -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="18"
                    Padding="16"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Trabajos"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Selecciona uno para cargar cliente, trabajo y documentos"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="#F8FAF6"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="13"
                                Height="38"
                                Padding="12,0">
                            <Grid>
                                <TextBox x:Name="WorkSearchTextBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"
                                         Padding="0"/>
                                <TextBlock x:Name="WorkSearchPlaceholderTextBlock"
                                           Text="Buscar trabajo, cliente, estado o fecha…"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Margin="1,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ListBox x:Name="BudgetQuotesListBox"
                             Grid.Row="1"
                             HorizontalContentAlignment="Stretch"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="BudgetQuotesListBox_SelectionChanged"
                             MouseDoubleClick="BudgetQuotesListBox_MouseDoubleClick"
                             ItemContainerStyle="{StaticResource JobListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CardBackground}"
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="{Binding CardBorderThickness}"
                                        CornerRadius="14"
                                        Padding="12,10"
                                        ToolTip="Doble clic para abrir el trabajo">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Client.Name, TargetNullValue=Cliente sin asignar}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Background="{Binding DeliveryBadgeBackground}"
                                                        CornerRadius="7"
                                                        Padding="7,3"
                                                        Visibility="{Binding OverdueBadgeVisibility}">
                                                    <TextBlock Text="{Binding DeliveryBadgeText}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding DeliveryBadgeForeground}"/>
                                                </Border>
                                                
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="Entrega"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DeliveryDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="Total"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Total, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Deposit, StringFormat=A cuenta · {0:N2} €, ConverterCulture=es-ES}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding PendingPaymentText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding PendingPaymentForeground}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <Border Background="{Binding StatusBackground}"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    MinWidth="82"
                                                    Height="26"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusLabelText}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding StatusForeground}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button x:Name="NewQuoteButton"
                                Content="＋ Crear presupuesto"
                                Height="42"
                                FontSize="15"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>
                        <Button x:Name="DuplicateQuoteButton"
                                Content="Duplicar trabajo"
                                Height="38"
                                FontSize="14"
                                Margin="0,8,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detalle del trabajo -->
            <ScrollViewer x:Name="WorkspaceScrollViewer"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="18"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="RESUMEN"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="BudgetWorkspaceTitleTextBlock"
                                           Text="Sin trabajo seleccionado"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Edita el cliente y el trabajo desde la barra superior. Completa importes, notas, productos y PDF desde este espacio."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBlock x:Name="BudgetWorkspaceClientTextBlock" Text="Cliente: —"/>
                                    <TextBlock x:Name="BudgetWorkspaceStatusTextBlock" Text="Estado: —"/>
                                    <TextBlock x:Name="BudgetWorkspaceDeliveryTextBlock" Text="Entrega: —"/>
                                    <TextBlock x:Name="BudgetWorkspaceTotalTextBlock" Text="Total: 0,00 €"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="24,0,0,0"
                                  MaxWidth="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Button x:Name="BudgetQuickSummaryButton"
                                            Content="Resumen"
                                            Height="34"
                                            Margin="0,0,0,7"
                                            Style="{StaticResource PrimaryActionButtonStyle}"/>
                                    <Button x:Name="BudgetQuickProductsButton"
                                            Content="Productos"
                                            Height="34"
                                            Margin="0,0,0,7"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BudgetQuickHistoryButton"
                                            Content="Historial"
                                            Height="34"
                                            ToolTip="Ir a Actividad reciente"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Button x:Name="BudgetQuickDocumentsButton"
                                            Content="Ver PDF"
                                            Height="34"
                                            Margin="0,0,0,7"
                                            ToolTip="Abrir la zona de PDF y documentos"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BudgetQuickExportPdfButton"
                                            Content="Exportar PDF"
                                            Height="34"
                                            ToolTip="Generar el PDF del trabajo actual"
                                            Style="{StaticResource PrimaryActionButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="PresupuestoEmptyHintBorder"
                            Grid.Row="0"
                            Background="#F8FAF6"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,112,0,14"
                            Visibility="Collapsed">
                        <TextBlock Text="Selecciona un trabajo o crea uno nuevo para empezar."
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="18"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="IMPORTES Y FECHAS"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,0,12"/>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Fecha evento" Style="{StaticResource ContextLabelTextStyle}"/>
                                <DatePicker x:Name="EventDatePicker" Style="{StaticResource ContextDatePickerStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="A cuenta" Style="{StaticResource ContextLabelTextStyle}"/>
                                <TextBox x:Name="DepositTextBox"
                                         Style="{StaticResource ContextTextBoxStyle}"
                                         Text="0"
                                         HorizontalContentAlignment="Right"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Pendiente" Style="{StaticResource ContextLabelTextStyle}"/>
                                <TextBlock x:Name="PendingAmountTextBlock"
                                           Text="0,00 €"
                                           Height="34"
                                           VerticalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ActivityTimelineBorder"
                            Grid.Row="2"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="18"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="ACTIVIDAD RECIENTE"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <Border Background="#F8F3EF" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Trabajo creado" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="Datos base del cliente y del trabajo disponibles" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FAF8F5" CornerRadius="12" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Productos preparados" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="Accede a Productos para completar el presupuesto" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <Border Background="#F8F3EF" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="PDF pendiente" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="Genera el documento cuando productos y notas estén completos" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FAF8F5" CornerRadius="12" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Última edición" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="Preparado para autosave e historial real en la siguiente fase" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="18"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="NOTAS"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <TextBox x:Name="QuoteNotesTextBox"
                                         Height="86"
                                         FontSize="14"
                                         Padding="10,8"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="QuoteNotesPlaceholderTextBlock"
                                           Text="Notas internas, ajustes, preferencias del cliente..."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="10,8,10,0"
                                           VerticalAlignment="Top"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <TextBox x:Name="ClientNotesTextBox"
                                         Height="72"
                                         FontSize="14"
                                         Padding="10,8"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="ClientNotesPlaceholderTextBlock"
                                           Text="Texto visible para el cliente en el PDF..."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="10,8,10,0"
                                           VerticalAlignment="Top"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
