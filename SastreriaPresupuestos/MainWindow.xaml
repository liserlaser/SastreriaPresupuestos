										FontWeight="Bold"
										Foreground="{StaticResource PrimaryBrush}"
										Margin="0,0,0,10"/>

                                    <ListBox
										x:Name="QuotesListBox"
										Grid.Row="2"
										HorizontalContentAlignment="Stretch"
										ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border
													Background="{Binding CardBackground}"
													BorderBrush="{Binding CardBorderBrush}"
													BorderThickness="{Binding CardBorderThickness}"
													CornerRadius="10"
													Padding="12"
													Margin="0,0,0,8">

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
