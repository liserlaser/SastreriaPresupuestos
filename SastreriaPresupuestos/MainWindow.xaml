                                                Foreground="{StaticResource MutedTextBrush}"
                                                Margin="0,12,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- PRESUPUESTOS DEL CLIENTE -->
                                    <TextBlock
										Grid.Row="1"
										Text="PRESUPUESTOS DEL CLIENTE"
