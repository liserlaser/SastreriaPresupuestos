<Window x:Class="SastreriaPresupuestos.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:views="clr-namespace:SastreriaPresupuestos.Views"
		Title="Sastrería Martínez Mor"
        Icon="Resources/AppIcon.ico"
		Height="750"
		Width="1280"
		MinWidth="1150"
		MinHeight="720"
		WindowStartupLocation="CenterScreen"
		Background="#F4F6F2"
		FontFamily="Segoe UI"
		Language="es-ES"
		Closing="Window_Closing">

    <Window.Resources>

        <x:Array Type="{x:Type sys:String}" x:Key="ProductList">
            <sys:String>Traje</sys:String>
            <sys:String>Chaqué</sys:String>
            <sys:String>Chaleco</sys:String>
            <sys:String>Chaqueta</sys:String>
            <sys:String>Pantalón</sys:String>
            <sys:String>Camisa</sys:String>
            <sys:String>Corbata</sys:String>
            <sys:String>Pañuelo</sys:String>
            <sys:String>Gemelos</sys:String>
            <sys:String>Tirantes</sys:String>
            <sys:String>Zapatos</sys:String>
            <sys:String>Concepto Libre</sys:String>
        </x:Array>

        <x:Array Type="{x:Type sys:String}" x:Key="QuoteStatusList">
            <sys:String>Pendiente</sys:String>
            <sys:String>Aceptado</sys:String>
            <sys:String>Rechazado</sys:String>
            <sys:String>Entregado</sys:String>
        </x:Array>

        <x:Array Type="{x:Type sys:String}" x:Key="TailoringList">
            <sys:String>Confeccion</sys:String>
            <sys:String>Medida</sys:String>
            <sys:String>Artesanal</sys:String>
        </x:Array>

        <!-- COLORES BASE -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F2"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F332D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A8B2A1"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D7468"/>
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#D7DDD2"/>

        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="CenterAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MoneyEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAF6"/>
        </Style>

        <Style x:Key="QuantityEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAF6"/>
        </Style>

        <!-- TABCONTROL -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="#EEF2EA"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
					x:Name="TabBorder"
					Background="{TemplateBinding Background}"
					BorderBrush="{TemplateBinding BorderBrush}"
					BorderThickness="1"
					CornerRadius="20,0,0,0"
					Padding="{TemplateBinding Padding}">

                            <ContentPresenter
						ContentSource="Header"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F8FAF6"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C8D1C2"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTOS -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <!-- CAJAS DE TEXTO -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <!-- COMBOBOX -->
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DATEPICKER -->
        <Style TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- BOTONES -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ActiveFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- BOTÓN SECUNDARIO CLARO -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EEF2EA"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#C8D1C2"/>
        </Style>

        <!-- BOTÓN OSCURO -->
        <Style x:Key="DarkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <!-- BOTÓN PELIGRO SUAVE -->
        <Style x:Key="DangerSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F3E5E2"/>
            <Setter Property="Foreground" Value="#7A2E2E"/>
            <Setter Property="BorderBrush" Value="#E0C2BC"/>
        </Style>

        <!-- BOTÓN PEQUEÑO CLARO -->
        <Style x:Key="SmallLightButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EEF2EA"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#C8D1C2"/>
        </Style>



        <!-- NAVEGACIÓN PRINCIPAL / SHELL -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallLightButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <!-- LISTBOX -->
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- DATAGRID -->
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EDE2"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAF6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2EA"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAF6"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2EA"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FabricCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FabricEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAF6"/>
        </Style>

        <!-- ELEMENTOS DE LISTAS LATERALES -->
        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
							x:Name="ItemBorder"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="10"
							Padding="{TemplateBinding Padding}"
							SnapsToDevicePixels="True">

                            <ContentPresenter
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAF6"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#C8D1C2"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2EA"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- SHELL PRINCIPAL -->
    <Grid Margin="0" Background="{StaticResource AppBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellSidebarColumn" Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TOOLBAR LATERAL RETRAÍBLE -->
        <Border
            Grid.Column="0"
            Background="#EEF2EA"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="0,0,1,0"
            Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image
                            x:Name="ShellLogoImage"
                            Source="/Resources/logovectordefA.png"
                            Width="46"
                            Height="46"
                            Stretch="Uniform"/>

                        <StackPanel
                            x:Name="ShellBrandPanel"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock Text="Martínez Mor" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Presupuestos y entregas" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button
                        x:Name="ToggleSidebarButton"
                        Grid.Column="1"
                        Content="☰"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="Contraer o expandir menú"/>
                </Grid>

                <!-- BÚSQUEDA GLOBAL SIEMPRE DISPONIBLE -->
                <Grid x:Name="ShellSearchPanel" Grid.Row="1" Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBox
                            x:Name="GlobalSearchTextBox"
                            Height="34"
                            FontSize="14"
                            ToolTip="Buscar cliente, teléfono, DNI, fecha, estado o título"
                            TextChanged="GlobalSearchTextBox_TextChanged"
                            KeyDown="GlobalSearchTextBox_KeyDown"/>

                        <TextBlock
                            x:Name="GlobalSearchPlaceholderTextBlock"
                            Text="Buscar..."
                            Foreground="{StaticResource MutedTextBrush}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>
                    </Grid>

                    <Border
                        x:Name="GlobalSearchResultsBorder"
                        Grid.Row="1"
                        Background="White"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="6"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">

                        <ListBox
                            x:Name="GlobalSearchResultsListBox"
                            BorderThickness="0"
                            Background="Transparent"
                            MaxHeight="260"
                            MouseDoubleClick="GlobalSearchResultsListBox_MouseDoubleClick">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel>
                                            <TextBlock
                                                Text="{Binding TypeLabel}"
                                                DockPanel.Dock="Right"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Margin="8,1,0,0"/>

                                            <TextBlock
                                                Text="{Binding PrimaryText}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding SecondaryText}"
                                            FontSize="11"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            Margin="0,2,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Button x:Name="DashboardNavButton" Content="📅  Dashboard" Tag="0" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNavButton_Click"/>
                    <Button x:Name="ClientsNavButton" Content="👥  Clientes" Tag="1" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNavButton_Click"/>
                    <Button x:Name="QuotesNavButton" Content="🧾  Presupuestos" Tag="2" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNavButton_Click"/>
                    <Button x:Name="ProductsNavButton" Content="📦  Productos" Tag="3" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNavButton_Click"/>
                    <Button x:Name="DocumentsNavButton" Content="📄  Documentos" Tag="4" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNavButton_Click"/>
                    <Button x:Name="SettingsNavButton" Content="⚙  Ajustes" Tag="5" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNavButton_Click"/>
                </StackPanel>

                <TextBlock
                    x:Name="ShellFooterTextBlock"
                    Grid.Row="3"
                    Text="Sastrería · Rework UX"
                    FontSize="11"
                    Foreground="{StaticResource MutedTextBrush}"
                    Margin="4,12,0,0"/>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Column="1" Margin="18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ContextPanelColumn" Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- CABECERA FIJA CONTEXTUAL -->
            <Grid Grid.ColumnSpan="2" Margin="0,0,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ShellBreadcrumbTextBlock"
                        Text="Inicio > Dashboard"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MutedTextBrush}"
                        Margin="0,0,0,4"/>

                    <TextBlock
                        x:Name="ShellSectionTitleTextBlock"
                        Text="Dashboard / Calendario"
                        FontSize="28"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="ShellSectionSubtitleTextBlock"
                        Text="Próximas entregas, vista semanal y vista mensual"
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Margin="0,4,0,0"/>
                </StackPanel>

                <!-- CONTEXTO ACTIVO -->
                <Border
                    Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    VerticalAlignment="Center">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="ActiveClientTextBlock"
                            Text="Cliente: —"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"/>

                        <TextBlock
                            x:Name="ActiveQuoteTextBlock"
                            Grid.Row="1"
                            Text="Presupuesto: —"
                            FontSize="12"
                            Foreground="{StaticResource MutedTextBrush}"
                            TextTrimming="CharacterEllipsis"
                            Margin="0,3,0,0"/>

                        <Border
                            Grid.Row="2"
                            Background="#EEF2EA"
                            CornerRadius="8"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0">

                            <TextBlock
                                x:Name="ActiveTotalTextBlock"
                                Text="Total: 0,00 €"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}"/>

                        </Border>

                    </Grid>

                </Border>

                <Button
                    x:Name="ToggleContextPanelButton"
                    Grid.Column="2"
                    Content="›"
                    Width="38"
                    Height="38"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource ShellIconButtonStyle}"/>

            </Grid>
            <!-- PESTAÑAS -->
            <TabControl
                x:Name="MainTabs"
                Grid.Row="1"
                Grid.Column="0"
                FontSize="14"
                FontWeight="SemiBold"
                SelectedIndex="0"
                SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="Height" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabItem Header="Semana">
                    <views:DashboardView x:Name="DashboardView"/>
                </TabItem>

                <TabItem Header="Clientes">
                    <views:ClientesView x:Name="ClientesView"/>
                </TabItem>

                <TabItem Header="Presupuestos">
                    <views:PresupuestoView x:Name="PresupuestoView"/>
                </TabItem>

                <TabItem Header="Productos">
                    <Grid Margin="0,0,0,0">

                        <!-- PRODUCTOS -->
                        <Border
							Background="{StaticResource CardBackgroundBrush}"
							CornerRadius="14"
							Padding="22"
							BorderBrush="{StaticResource BorderSoftBrush}"
							BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,20">

                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock
											Text="PRODUCTOS"
											FontSize="22"
											FontWeight="Bold"/>

                                        <TextBlock
											Text="Añade prendas, complementos y conceptos personalizados"
											FontSize="13"
											Foreground="{StaticResource MutedTextBrush}"
											Margin="0,2,0,0"/>

                                        <Border
											x:Name="ProductsEmptyHintBorder"
											Background="#F8FAF6"
											BorderBrush="{StaticResource BorderSoftBrush}"
											BorderThickness="1"
											CornerRadius="10"
											Padding="12"
											Margin="0,12,0,0"
											Visibility="Collapsed">

                                            <TextBlock
												x:Name="ProductsEmptyHintTextBlock"
												Text="Selecciona o crea un cliente antes de añadir productos."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"/>

                                        </Border>
                                    </StackPanel>

                                    <StackPanel
										DockPanel.Dock="Right"
										Orientation="Horizontal"
										HorizontalAlignment="Right">

                                        <TextBlock
											x:Name="ProductsUnsavedChangesTextBlock"
											Text="Cambios sin guardar"
											VerticalAlignment="Center"
											FontWeight="SemiBold"
											Foreground="{StaticResource AccentBrush}"
											Margin="0,0,14,0"
											Visibility="Collapsed"/>

                                        <Button
											Content="+ Añadir Producto"
											Width="180"
											Height="40"
											Margin="0,0,10,0"
											x:Name="AddProductButton"
											Style="{StaticResource PrimaryActionButtonStyle}"/>

                                        <Button
											x:Name="SaveProductsButton"
											Content="Guardar Presupuesto"
											Width="170"
											Height="40"
											FontSize="15"
											Style="{StaticResource SecondaryButtonStyle}"/>

                                    </StackPanel>

                                </DockPanel>

                                <!-- TABLA -->
                                <DataGrid
									Grid.Row="1"
									x:Name="ProductsDataGrid"
									PreparingCellForEdit="ProductsDataGrid_PreparingCellForEdit"
									AutoGenerateColumns="False"
									CanUserAddRows="False"
									HeadersVisibility="Column"
									RowHeight="42"
									FontSize="14"
									IsReadOnly="False"
									IsSynchronizedWithCurrentItem="True"
									AlternationCount="2"
									SelectionMode="Single"
									SelectionUnit="FullRow">

                                    <DataGrid.Columns>

                                        <!-- CANTIDAD -->
                                        <DataGridTextColumn
											Header="Cant."
											Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											ElementStyle="{StaticResource CenterAlignedCellStyle}"
											EditingElementStyle="{StaticResource QuantityEditingTextBoxStyle}"
											Width="70" />

                                        <!-- PRODUCTO -->
                                        <DataGridTemplateColumn Header="Producto" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox
														ItemsSource="{StaticResource ProductList}"
														SelectedItem="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
														VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- TIPO -->
                                        <DataGridTemplateColumn Header="Tipo" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox
														ItemsSource="{Binding AvailableTailoringTypes}"
														SelectedItem="{Binding TailoringType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
														VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- TEJIDO -->
                                        <DataGridTextColumn
											Header="Tejido / Ref."
											Binding="{Binding Fabric, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											ElementStyle="{StaticResource FabricCellStyle}"
											EditingElementStyle="{StaticResource FabricEditingTextBoxStyle}"
											Width="*" />

                                        <!-- PRECIO BASE -->
                                        <DataGridTextColumn
											Header="Base"
											Binding="{Binding BasePrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											EditingElementStyle="{StaticResource MoneyEditingTextBoxStyle}"
											Width="115" />

                                        <!-- PRECIO TEJIDO -->
                                        <DataGridTextColumn
											Header="Precio Tejido"
											Binding="{Binding FabricPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											EditingElementStyle="{StaticResource MoneyEditingTextBoxStyle}"
											Width="115" />

                                        <!-- INCREMENTO / DESCUENTO -->
                                        <DataGridTextColumn
											Header="Ajuste"
											Binding="{Binding ManualPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											EditingElementStyle="{StaticResource MoneyEditingTextBoxStyle}"
											Width="115" />

                                        <!-- TOTAL -->
                                        <DataGridTextColumn
											Header="Total"
											Binding="{Binding Total, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											IsReadOnly="True"
											Width="125" />

                                        <!-- ACCIONES -->
                                        <DataGridTemplateColumn Header="" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                        <Button
															Content="↑"
															FontSize="12"
															Width="34"
															Height="32"
															Margin="0,0,4,0"
															ToolTip="Mover arriba"
															Click="MoveProductUp_Click"
															Style="{StaticResource SmallLightButtonStyle}"/>

                                                        <Button
															Content="↓"
															FontSize="12"
															Width="34"
															Height="32"
															Margin="0,0,6,0"
															ToolTip="Mover abajo"
															Click="MoveProductDown_Click"
															Style="{StaticResource SmallLightButtonStyle}"/>

                                                        <Button
															Content="⧉"
															FontSize="12"
															Width="34"
															Height="32"
															Margin="0,0,6,0"
															ToolTip="Duplicar línea"
															Click="DuplicateProduct_Click"
															Style="{StaticResource SmallLightButtonStyle}"/>

                                                        <Button
															Content="✕"
															FontSize="12"
															Width="34"
															Height="32"
															ToolTip="Eliminar línea"
															Click="DeleteProduct_Click"
															Style="{StaticResource DangerSmallButtonStyle}"/>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>

                                </DataGrid>

                                <!-- TOTAL -->
                                <Border
									Grid.Row="2"
									HorizontalAlignment="Right"
									Margin="0,20,0,0"
									Background="#EEF2EA"
									BorderBrush="{StaticResource BorderSoftBrush}"
									BorderThickness="1"
									CornerRadius="10"
									Padding="18,10">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock
											Text="TOTAL:"
											FontSize="22"
											FontWeight="Bold"
											Foreground="{StaticResource AccentBrush}"
											Margin="0,0,18,0"/>

                                        <TextBlock
											Text="0,00 €"
											FontSize="22"
											FontWeight="Bold"
											Foreground="{StaticResource PrimaryBrush}"
											x:Name="TotalTextBlock"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Border>

                    </Grid>
                </TabItem>

                <TabItem Header="Documentos">
                    <Grid Margin="0,0,0,0">

                        <Border
							Background="{StaticResource CardBackgroundBrush}"
							CornerRadius="14"
							Padding="22"
							BorderBrush="{StaticResource BorderSoftBrush}"
							BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,24">

                                    <TextBlock
										Text="EXPORTAR"
										FontSize="24"
										FontWeight="Bold"/>

                                    <TextBlock
										Text="Genera documentos para enviar al cliente."
										FontSize="14"
										Foreground="{StaticResource MutedTextBrush}"
										Margin="0,4,0,0"/>

                                    <Border
										x:Name="DocumentsEmptyHintBorder"
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="10"
										Padding="12"
										Margin="0,12,0,0"
										Visibility="Collapsed">

                                        <TextBlock
											x:Name="DocumentsEmptyHintTextBlock"
											Text="Selecciona o crea un presupuesto con productos antes de exportar documentos."
											FontSize="13"
											Foreground="{StaticResource MutedTextBrush}"
											TextWrapping="Wrap"/>

                                    </Border>

                                </StackPanel>

                                <WrapPanel
									Grid.Row="1"
									ItemWidth="260">


                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16">

                                        <StackPanel>

                                            <TextBlock
												Text="PDF actual"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Exporta el presupuesto abierto."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>
                                            <Button
												x:Name="ExportPdfButton"
												Content="Exportar PDF"
												Height="40"
												FontSize="15"
                                                HorizontalAlignment="Stretch"
												Style="{StaticResource DarkButtonStyle}"/>

                                            <Button
												x:Name="ExportClientSheetButton"
												Content="Exportar ficha cliente"
												Click="ExportClientSheetButton_Click"
                                                HorizontalAlignment="Stretch"
												Style="{StaticResource SecondaryButtonStyle}"
												Margin="0,10,0,0"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16">

                                        <StackPanel>

                                            <TextBlock
												Text="PDF opciones"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Exporta todos los presupuestos del cliente."
												FontSize="13"
                                                HorizontalAlignment="Stretch"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,14,0,14"/>

                                            <Button
												x:Name="ExportAllQuotesPdfButton"
												Content="Exportar Opciones"
												Height="40"
												FontSize="15"
												Style="{StaticResource DarkButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16"
										Opacity="0.65">

                                        <StackPanel>

                                            <TextBlock
												Text="Imagen WhatsApp"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Pendiente: imagen vertical para enviar rápido."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>

                                            <Button
												Content="Próximamente"
												Height="40"
												FontSize="15"
												IsEnabled="False"
												Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16"
										Opacity="0.65">

                                        <StackPanel>

                                            <TextBlock
												Text="Editable"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Pendiente: DOCX/XLSX compatible."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>

                                            <Button
												Content="Próximamente"
												Height="40"
												FontSize="15"
												IsEnabled="False"
												Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                </WrapPanel>

                            </Grid>

                        </Border>

                    </Grid>
                </TabItem>

                <TabItem Header="Ajustes">
                    <Grid Margin="0,0,0,0">

                        <Border
							Background="{StaticResource CardBackgroundBrush}"
							CornerRadius="14"
							Padding="22"
							BorderBrush="{StaticResource BorderSoftBrush}"
							BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,24">

                                    <TextBlock
										Text="CONFIGURACIÓN"
										FontSize="24"
										FontWeight="Bold"/>

                                    <TextBlock
										Text="Opciones de mantenimiento y configuración de la aplicación."
										FontSize="14"
										Foreground="{StaticResource MutedTextBrush}"
										Margin="0,4,0,0"/>

                                </StackPanel>

                                <WrapPanel
									Grid.Row="1"
									ItemWidth="270">

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16">

                                        <StackPanel>

                                            <TextBlock
												Text="Precios"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Modifica las tarifas base de prendas y complementos."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>

                                            <Button
												x:Name="PricesConfigButton"
												Content="Configurar Precios"
												Height="40"
												FontSize="15"
												Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16">

                                        <StackPanel>

                                            <TextBlock
												Text="Copia de seguridad"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Crea una copia manual de la base de datos."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>

                                            <Button
												x:Name="BackupButton"
												Content="Copia Seguridad"
												Height="40"
												FontSize="15"
												Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                </WrapPanel>

                            </Grid>

                        </Border>

                    </Grid>
                </TabItem>

            </TabControl>

            <!-- PANEL CONTEXTUAL DERECHO -->
            <views:ContextPanelView
                x:Name="ContextPanelView"
                Grid.Row="1"
                Grid.Column="1"
                Margin="16,0,0,0"
                SaveRequested="ContextSaveButton_Click"
                MarkDeliveredRequested="ContextMarkDeliveredButton_Click"
                ExportPdfRequested="ContextExportPdfButton_Click"
                DocumentsRequested="ContextDocumentsButton_Click"/>


        </Grid>

    </Grid>
</Window>