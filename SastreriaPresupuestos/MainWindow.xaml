                                        <TextBlock
											x:Name="ClientNotesPlaceholderTextBlock"
											Text="Texto visible para el cliente en el PDF..."
											Foreground="{StaticResource MutedTextBrush}"
											Margin="10,8,10,0"
											VerticalAlignment="Top"
											IsHitTestVisible="False"/>

                                    </Grid>

                                </Grid>
                            </Border>

                            <!-- PRESUPUESTOS Y ACCIONES -->
                            <Grid
								Grid.Row="3"
								Margin="0,4,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tarjetas compactas de presupuestos -->
                                <ListBox
									x:Name="BudgetQuotesListBox"
									Grid.Column="0"
									HorizontalContentAlignment="Stretch"
									BorderThickness="0"
									Background="Transparent"
									MaxHeight="78"
									ScrollViewer.HorizontalScrollBarVisibility="Auto"
									ScrollViewer.VerticalScrollBarVisibility="Disabled"
									SelectionChanged="BudgetQuotesListBox_SelectionChanged"
									MouseDoubleClick="BudgetQuotesListBox_MouseDoubleClick"
									ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border
					Width="210"
					Height="70"
					Background="{Binding CardBackground}"
					BorderBrush="{Binding CardBorderBrush}"
					BorderThickness="{Binding CardBorderThickness}"
					CornerRadius="10"
					Padding="9"
					Margin="0,0,8,0"
					ToolTip="Presupuesto del cliente">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Text="{Binding DisplayTitle}"
							FontSize="12"
							FontWeight="{Binding TitleWeight}"
							TextTrimming="CharacterEllipsis"/>

                                                    <Border
							Grid.Row="0"
							Grid.Column="1"
							Background="{Binding StatusBackground}"
							CornerRadius="7"
							Padding="6,2"
							Margin="6,0,0,0">

                                                        <TextBlock
								Text="{Binding StatusLabelText}"
								FontSize="8"
								FontWeight="Bold"
								Foreground="{Binding StatusForeground}"/>
                                                    </Border>

                                                    <TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							Text="{Binding DeliveryDate, StringFormat=Entrega: {0:dd/MM/yyyy}}"
							FontSize="10"
							Foreground="{StaticResource MutedTextBrush}"
							Margin="0,3,0,0"/>

                                                    <TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							Text="{Binding Total, StringFormat=Total: {0:N2} €, ConverterCulture=es-ES}"
							FontSize="11"
							FontWeight="SemiBold"
							Foreground="{StaticResource PrimaryBrush}"
							Margin="0,3,0,0"/>

                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Botones -->
                                <StackPanel
		Grid.Column="1"
		Orientation="Horizontal"
		HorizontalAlignment="Right"
		VerticalAlignment="Bottom"
		Margin="14,0,0,0">

                                    <TextBlock
			x:Name="UnsavedChangesTextBlock"
			Text="Cambios sin guardar"
			VerticalAlignment="Center"
			FontWeight="SemiBold"
			Foreground="{StaticResource AccentBrush}"
			Margin="0,0,18,0"
			Visibility="Collapsed"/>

                                    <Button
			x:Name="NewQuoteButton"
			Content="Nuevo Presupuesto"
			Width="180"
			Height="45"
			Margin="0,0,10,0"
			FontSize="16"
			Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button
			x:Name="DuplicateQuoteButton"
			Content="Duplicar Presupuesto"
			Width="180"
			Height="45"
			Margin="0,0,10,0"
			FontSize="16"
			Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button
										x:Name="SaveButton"
										Content="Guardar"
										Width="140"
										Height="45"
										FontSize="16"
										Style="{StaticResource PrimaryActionButtonStyle}"/>

                                </StackPanel>

                            </Grid>

                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Productos">
                    <Grid Margin="0,0,0,0">

                        <!-- PRODUCTOS -->
                        <Border
							Background="{StaticResource CardBackgroundBrush}"
							CornerRadius="14"
							Padding="22"
							BorderBrush="{StaticResource BorderSoftBrush}"
							BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,20">

                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock
											Text="PRODUCTOS"
											FontSize="22"
											FontWeight="Bold"/>

                                        <TextBlock
											Text="Añade prendas, complementos y conceptos personalizados"
											FontSize="13"
											Foreground="{StaticResource MutedTextBrush}"
											Margin="0,2,0,0"/>

                                        <Border
											x:Name="ProductsEmptyHintBorder"
											Background="#F8FAF6"
											BorderBrush="{StaticResource BorderSoftBrush}"
											BorderThickness="1"
											CornerRadius="10"
											Padding="12"
											Margin="0,12,0,0"
											Visibility="Collapsed">

                                            <TextBlock
												x:Name="ProductsEmptyHintTextBlock"
												Text="Selecciona o crea un cliente antes de añadir productos."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"/>

                                        </Border>
                                    </StackPanel>

                                    <StackPanel
										DockPanel.Dock="Right"
										Orientation="Horizontal"
										HorizontalAlignment="Right">

                                        <TextBlock
											x:Name="ProductsUnsavedChangesTextBlock"
											Text="Cambios sin guardar"
											VerticalAlignment="Center"
											FontWeight="SemiBold"
											Foreground="{StaticResource AccentBrush}"
											Margin="0,0,14,0"
											Visibility="Collapsed"/>

                                        <Button
											Content="+ Añadir Producto"
											Width="180"
											Height="40"
											Margin="0,0,10,0"
											x:Name="AddProductButton"
											Style="{StaticResource PrimaryActionButtonStyle}"/>

                                        <Button
											x:Name="SaveProductsButton"
											Content="Guardar Presupuesto"
											Width="170"
											Height="40"
											FontSize="15"
											Style="{StaticResource SecondaryButtonStyle}"/>

                                    </StackPanel>

                                </DockPanel>

                                <!-- TABLA -->
                                <DataGrid
									Grid.Row="1"
									x:Name="ProductsDataGrid"
									PreparingCellForEdit="ProductsDataGrid_PreparingCellForEdit"
									AutoGenerateColumns="False"
									CanUserAddRows="False"
									HeadersVisibility="Column"
									RowHeight="42"
									FontSize="14"
									IsReadOnly="False"
									IsSynchronizedWithCurrentItem="True"
									AlternationCount="2"
									SelectionMode="Single"
									SelectionUnit="FullRow">

                                    <DataGrid.Columns>

                                        <!-- CANTIDAD -->
                                        <DataGridTextColumn
											Header="Cant."
											Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											ElementStyle="{StaticResource CenterAlignedCellStyle}"
											EditingElementStyle="{StaticResource QuantityEditingTextBoxStyle}"
											Width="70" />

                                        <!-- PRODUCTO -->
                                        <DataGridTemplateColumn Header="Producto" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox
														ItemsSource="{StaticResource ProductList}"
														SelectedItem="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
														VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- TIPO -->
                                        <DataGridTemplateColumn Header="Tipo" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox
														ItemsSource="{Binding AvailableTailoringTypes}"
														SelectedItem="{Binding TailoringType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
														VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- TEJIDO -->
                                        <DataGridTextColumn
											Header="Tejido / Ref."
											Binding="{Binding Fabric, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											ElementStyle="{StaticResource FabricCellStyle}"
											EditingElementStyle="{StaticResource FabricEditingTextBoxStyle}"
											Width="*" />

                                        <!-- PRECIO BASE -->
                                        <DataGridTextColumn
											Header="Base"
											Binding="{Binding BasePrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											EditingElementStyle="{StaticResource MoneyEditingTextBoxStyle}"
											Width="115" />

                                        <!-- PRECIO TEJIDO -->
                                        <DataGridTextColumn
											Header="Precio Tejido"
											Binding="{Binding FabricPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											EditingElementStyle="{StaticResource MoneyEditingTextBoxStyle}"
											Width="115" />

                                        <!-- INCREMENTO / DESCUENTO -->
                                        <DataGridTextColumn
											Header="Ajuste"
											Binding="{Binding ManualPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											EditingElementStyle="{StaticResource MoneyEditingTextBoxStyle}"
											Width="115" />

                                        <!-- TOTAL -->
                                        <DataGridTextColumn
											Header="Total"
											Binding="{Binding Total, StringFormat={}{0:N2} €, ConverterCulture=es-ES}"
											ElementStyle="{StaticResource RightAlignedCellStyle}"
											IsReadOnly="True"
											Width="125" />

                                        <!-- ACCIONES -->
                                        <DataGridTemplateColumn Header="" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                        <Button
															Content="↑"
															FontSize="12"
															Width="34"
															Height="32"
															Margin="0,0,4,0"
															ToolTip="Mover arriba"
															Click="MoveProductUp_Click"
															Style="{StaticResource SmallLightButtonStyle}"/>

                                                        <Button
															Content="↓"
															FontSize="12"
															Width="34"
															Height="32"
															Margin="0,0,6,0"
															ToolTip="Mover abajo"
															Click="MoveProductDown_Click"
															Style="{StaticResource SmallLightButtonStyle}"/>

                                                        <Button
															Content="⧉"
															FontSize="12"
															Width="34"
															Height="32"
															Margin="0,0,6,0"
															ToolTip="Duplicar línea"
															Click="DuplicateProduct_Click"
															Style="{StaticResource SmallLightButtonStyle}"/>

                                                        <Button
															Content="✕"
															FontSize="12"
															Width="34"
															Height="32"
															ToolTip="Eliminar línea"
															Click="DeleteProduct_Click"
															Style="{StaticResource DangerSmallButtonStyle}"/>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>

                                </DataGrid>

                                <!-- TOTAL -->
                                <Border
									Grid.Row="2"
									HorizontalAlignment="Right"
									Margin="0,20,0,0"
									Background="#EEF2EA"
									BorderBrush="{StaticResource BorderSoftBrush}"
									BorderThickness="1"
									CornerRadius="10"
									Padding="18,10">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock
											Text="TOTAL:"
											FontSize="22"
											FontWeight="Bold"
											Foreground="{StaticResource AccentBrush}"
											Margin="0,0,18,0"/>

                                        <TextBlock
											Text="0,00 €"
											FontSize="22"
											FontWeight="Bold"
											Foreground="{StaticResource PrimaryBrush}"
											x:Name="TotalTextBlock"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Border>

                    </Grid>
                </TabItem>

                <TabItem Header="Documentos">
                    <Grid Margin="0,0,0,0">

                        <Border
							Background="{StaticResource CardBackgroundBrush}"
							CornerRadius="14"
							Padding="22"
							BorderBrush="{StaticResource BorderSoftBrush}"
							BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,24">

                                    <TextBlock
										Text="EXPORTAR"
										FontSize="24"
										FontWeight="Bold"/>

                                    <TextBlock
										Text="Genera documentos para enviar al cliente."
										FontSize="14"
										Foreground="{StaticResource MutedTextBrush}"
										Margin="0,4,0,0"/>

                                    <Border
										x:Name="DocumentsEmptyHintBorder"
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="10"
										Padding="12"
										Margin="0,12,0,0"
										Visibility="Collapsed">

                                        <TextBlock
											x:Name="DocumentsEmptyHintTextBlock"
											Text="Selecciona o crea un presupuesto con productos antes de exportar documentos."
											FontSize="13"
											Foreground="{StaticResource MutedTextBrush}"
											TextWrapping="Wrap"/>

                                    </Border>

                                </StackPanel>

                                <WrapPanel
									Grid.Row="1"
									ItemWidth="260">


                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16">

                                        <StackPanel>

                                            <TextBlock
												Text="PDF actual"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Exporta el presupuesto abierto."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>
                                            <Button
												x:Name="ExportPdfButton"
												Content="Exportar PDF"
												Height="40"
												FontSize="15"
                                                HorizontalAlignment="Stretch"
												Style="{StaticResource DarkButtonStyle}"/>

                                            <Button
												x:Name="ExportClientSheetButton"
												Content="Exportar ficha cliente"
												Click="ExportClientSheetButton_Click"
                                                HorizontalAlignment="Stretch"
												Style="{StaticResource SecondaryButtonStyle}"
												Margin="0,10,0,0"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16">

                                        <StackPanel>

                                            <TextBlock
												Text="PDF opciones"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Exporta todos los presupuestos del cliente."
												FontSize="13"
                                                HorizontalAlignment="Stretch"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,14,0,14"/>

                                            <Button
												x:Name="ExportAllQuotesPdfButton"
												Content="Exportar Opciones"
												Height="40"
												FontSize="15"
												Style="{StaticResource DarkButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16"
										Opacity="0.65">

                                        <StackPanel>

                                            <TextBlock
												Text="Imagen WhatsApp"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Pendiente: imagen vertical para enviar rápido."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>

                                            <Button
												Content="Próximamente"
												Height="40"
												FontSize="15"
												IsEnabled="False"
												Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16"
										Opacity="0.65">

                                        <StackPanel>

                                            <TextBlock
												Text="Editable"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Pendiente: DOCX/XLSX compatible."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>

                                            <Button
												Content="Próximamente"
												Height="40"
												FontSize="15"
												IsEnabled="False"
												Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                </WrapPanel>

                            </Grid>

                        </Border>

                    </Grid>
                </TabItem>

                <TabItem Header="Ajustes">
                    <Grid Margin="0,0,0,0">

                        <Border
							Background="{StaticResource CardBackgroundBrush}"
							CornerRadius="14"
							Padding="22"
							BorderBrush="{StaticResource BorderSoftBrush}"
							BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,24">

                                    <TextBlock
										Text="CONFIGURACIÓN"
										FontSize="24"
										FontWeight="Bold"/>

                                    <TextBlock
										Text="Opciones de mantenimiento y configuración de la aplicación."
										FontSize="14"
										Foreground="{StaticResource MutedTextBrush}"
										Margin="0,4,0,0"/>

                                </StackPanel>

                                <WrapPanel
									Grid.Row="1"
									ItemWidth="270">

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16">

                                        <StackPanel>

                                            <TextBlock
												Text="Precios"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Modifica las tarifas base de prendas y complementos."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>

                                            <Button
												x:Name="PricesConfigButton"
												Content="Configurar Precios"
												Height="40"
												FontSize="15"
												Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                    <Border
										Background="#F8FAF6"
										BorderBrush="{StaticResource BorderSoftBrush}"
										BorderThickness="1"
										CornerRadius="12"
										Padding="16"
										Margin="0,0,16,16">

                                        <StackPanel>

                                            <TextBlock
												Text="Copia de seguridad"
												FontSize="18"
												FontWeight="Bold"/>

                                            <TextBlock
												Text="Crea una copia manual de la base de datos."
												FontSize="13"
												Foreground="{StaticResource MutedTextBrush}"
												TextWrapping="Wrap"
												Margin="0,6,0,14"/>

                                            <Button
												x:Name="BackupButton"
												Content="Copia Seguridad"
												Height="40"
												FontSize="15"
												Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Border>

                                </WrapPanel>

                            </Grid>

                        </Border>

                    </Grid>
                </TabItem>

            </TabControl>

            <!-- PANEL CONTEXTUAL DERECHO -->
            <views:ContextPanelView
                x:Name="ContextPanelView"
                Grid.Row="1"
                Grid.Column="1"
                Margin="16,0,0,0"
                SaveRequested="ContextSaveButton_Click"
                MarkDeliveredRequested="ContextMarkDeliveredButton_Click"
                ExportPdfRequested="ContextExportPdfButton_Click"
                DocumentsRequested="ContextDocumentsButton_Click"/>


        </Grid>

    </Grid>
</Window>