                                                </StackPanel>

                                                <StackPanel>
                                                    <TextBlock Text="Próxima entrega" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                                    <TextBlock x:Name="ClientDetailNextDeliveryTextBlock" Text="—" FontSize="14" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock
                                                x:Name="ClientDetailSummaryTextBlock"
