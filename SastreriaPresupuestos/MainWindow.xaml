<Window x:Class="SastreriaPresupuestos.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:views="clr-namespace:SastreriaPresupuestos.Views"
		Title="Sastrería Martínez Mor"
        Icon="Resources/AppIcon.ico"
		Height="750"
		Width="1280"
		MinWidth="980"
		MinHeight="720"
		WindowStartupLocation="CenterScreen"
		Background="#F4F6F2"
		FontFamily="Segoe UI"
		Language="es-ES"
		Closing="Window_Closing">

    <Window.Resources>

        <x:Array Type="{x:Type sys:String}" x:Key="ProductList">
            <sys:String>Traje</sys:String>
            <sys:String>Chaqué</sys:String>
            <sys:String>Chaleco</sys:String>
            <sys:String>Chaqueta</sys:String>
            <sys:String>Pantalón</sys:String>
            <sys:String>Camisa</sys:String>
            <sys:String>Corbata</sys:String>
            <sys:String>Pañuelo</sys:String>
            <sys:String>Gemelos</sys:String>
            <sys:String>Tirantes</sys:String>
            <sys:String>Zapatos</sys:String>
            <sys:String>Concepto Libre</sys:String>
        </x:Array>

        <x:Array Type="{x:Type sys:String}" x:Key="QuoteStatusList">
            <sys:String>Pendiente</sys:String>
            <sys:String>Aceptado</sys:String>
            <sys:String>Rechazado</sys:String>
            <sys:String>Entregado</sys:String>
        </x:Array>

        <x:Array Type="{x:Type sys:String}" x:Key="TailoringList">
            <sys:String>Confeccion</sys:String>
            <sys:String>Medida</sys:String>
            <sys:String>Artesanal</sys:String>
        </x:Array>

        <!-- COLORES BASE -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F2"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F332D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A8B2A1"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D7468"/>
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#D7DDD2"/>

        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="CenterAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MoneyEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAF6"/>
        </Style>

        <Style x:Key="QuantityEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAF6"/>
        </Style>

        <!-- TABCONTROL -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="#EEF2EA"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
					x:Name="TabBorder"
					Background="{TemplateBinding Background}"
					BorderBrush="{TemplateBinding BorderBrush}"
					BorderThickness="1"
					CornerRadius="20,0,0,0"
					Padding="{TemplateBinding Padding}">

                            <ContentPresenter
						ContentSource="Header"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F8FAF6"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C8D1C2"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTOS -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <!-- CAJAS DE TEXTO -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <!-- COMBOBOX -->
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DATEPICKER -->
        <Style TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- BOTONES -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- BOTÓN SECUNDARIO CLARO -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EEF2EA"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#C8D1C2"/>
        </Style>

        <!-- BOTÓN DE TAB INTERNA DEL WORKSPACE -->
        <Style x:Key="WorkspaceTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- BOTÓN OSCURO -->
        <Style x:Key="DarkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <!-- BOTÓN PELIGRO SUAVE -->
        <Style x:Key="DangerSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F3E5E2"/>
            <Setter Property="Foreground" Value="#7A2E2E"/>
            <Setter Property="BorderBrush" Value="#E0C2BC"/>
        </Style>

        <!-- BOTÓN PEQUEÑO CLARO -->
        <Style x:Key="SmallLightButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EEF2EA"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#C8D1C2"/>
        </Style>



        <!-- NAVEGACIÓN PRINCIPAL / SHELL -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallLightButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <!-- LISTBOX -->
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- DATAGRID -->
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EDE2"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAF6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2EA"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAF6"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2EA"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FabricCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FabricEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAF6"/>
        </Style>

        <!-- ELEMENTOS DE LISTAS LATERALES -->
        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
							x:Name="ItemBorder"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="10"
							Padding="{TemplateBinding Padding}"
							SnapsToDevicePixels="True">

                            <ContentPresenter
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAF6"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#C8D1C2"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2EA"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- SHELL PRINCIPAL -->
    <Grid Margin="0" Background="{StaticResource AppBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellSidebarColumn" Width="220" MinWidth="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TOOLBAR LATERAL RETRAÍBLE -->
        <Border
            Grid.Column="0"
            Background="#EEF2EA"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="0,0,1,0"
            Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="ShellBrandTextBlock"
                        Text="Martínez Mor"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"/>

                    <Button
                        x:Name="ToggleSidebarButton"
                        Grid.Column="1"
                        Content="☰"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="Contraer o expandir menú"/>
                </Grid>

                <!-- BÚSQUEDA GLOBAL SIEMPRE DISPONIBLE -->
                <Grid x:Name="ShellSearchPanel" Grid.Row="1" Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBox
                            x:Name="GlobalSearchTextBox"
                            Height="34"
                            FontSize="14"
                            ToolTip="Buscar cliente, teléfono, DNI, fecha, estado o título"
                            TextChanged="GlobalSearchTextBox_TextChanged"
                            KeyDown="GlobalSearchTextBox_KeyDown"/>

                        <TextBlock
                            x:Name="GlobalSearchPlaceholderTextBlock"
                            Text="Buscar..."
                            Foreground="{StaticResource MutedTextBrush}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>
                    </Grid>

                    <Border
                        x:Name="GlobalSearchResultsBorder"
                        Grid.Row="1"
                        Background="White"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="6"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">

                        <ListBox
                            x:Name="GlobalSearchResultsListBox"
                            BorderThickness="0"
                            Background="Transparent"
                            MaxHeight="260"
                            MouseDoubleClick="GlobalSearchResultsListBox_MouseDoubleClick">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel>
                                            <TextBlock
                                                Text="{Binding TypeLabel}"
                                                DockPanel.Dock="Right"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Margin="8,1,0,0"/>

                                            <TextBlock
                                                Text="{Binding PrimaryText}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding SecondaryText}"
                                            FontSize="11"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            Margin="0,2,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2">

                    <Border
                        x:Name="ActiveWorkspaceBorder"
                        Background="White"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,18">

                        <StackPanel>
                            <TextBlock
                                x:Name="ActiveWorkspaceLabel"
                                Text="TRABAJO ACTIVO"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource MutedTextBrush}"/>

                            <TextBlock
                                x:Name="ActiveWorkspaceTitle"
                                Text="Ningún trabajo abierto"
                                FontSize="14"
                                FontWeight="Bold"
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                x:Name="ActiveWorkspaceSubtitle"
                                Text="Selecciona un trabajo para ver contexto"
                                FontSize="11"
                                Foreground="{StaticResource MutedTextBrush}"
                                Margin="0,4,0,0"
                                TextWrapping="Wrap"/>

                            <Border
                                Height="1"
                                Background="{StaticResource BorderSoftBrush}"
                                Margin="0,10,0,10"/>

                            <TextBlock
                                x:Name="ActiveClientTextBlock"
                                Text="Cliente: —"
                                FontSize="11"
                                Foreground="{StaticResource MutedTextBrush}"
                                TextTrimming="CharacterEllipsis"/>

                            <TextBlock
                                x:Name="ActivePhoneTextBlock"
                                Text="Teléfono: —"
                                FontSize="11"
                                Foreground="{StaticResource MutedTextBrush}"
                                Margin="0,4,0,0"
                                TextTrimming="CharacterEllipsis"/>

                            <TextBlock
                                x:Name="ActiveQuoteTextBlock"
                                Text="Estado: Pendiente"
                                FontSize="11"
                                Foreground="{StaticResource MutedTextBrush}"
                                Margin="0,4,0,0"
                                TextTrimming="CharacterEllipsis"/>

                            <TextBlock
                                x:Name="ActiveDeliveryTextBlock"
                                Text="Entrega: —"
                                FontSize="11"
                                Foreground="{StaticResource MutedTextBrush}"
                                Margin="0,4,0,0"
                                TextTrimming="CharacterEllipsis"/>

                            <TextBlock
                                x:Name="ActiveDepositTextBlock"
                                Text="Señal: 0,00 €"
                                FontSize="11"
                                Foreground="{StaticResource MutedTextBrush}"
                                Margin="0,4,0,0"
                                TextTrimming="CharacterEllipsis"/>

                            <Border
                                Background="#EEF2EA"
                                CornerRadius="8"
                                Padding="8,5"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0">

                                <TextBlock
                                    x:Name="ActiveTotalTextBlock"
                                    Text="Total: 0,00 €"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>

                            <Border
                                Height="1"
                                Background="{StaticResource BorderSoftBrush}"
                                Margin="0,12,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock
                                    Text="Workspace"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock
                                    Text="accesos rápidos"
                                    FontSize="10"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    HorizontalAlignment="Right"/>
                            </Grid>

                            <UniformGrid Columns="3">
                                <Button
                                    x:Name="ActiveSummaryButton"
                                    Content="Resumen"
                                    Tag="2"
                                    Margin="0,0,4,0"
                                    Style="{StaticResource WorkspaceTabButtonStyle}"
                                    Click="WorkspaceSectionButton_Click"/>

                                <Button
                                    x:Name="ActiveProductsButton"
                                    Content="Productos"
                                    Tag="3"
                                    Margin="0,0,4,0"
                                    Style="{StaticResource WorkspaceTabButtonStyle}"
                                    Click="WorkspaceSectionButton_Click"/>

                                <Button
                                    x:Name="ActiveDocumentsButton"
                                    Content="PDF"
                                    Tag="4"
                                    Style="{StaticResource WorkspaceTabButtonStyle}"
                                    Click="WorkspaceSectionButton_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="DashboardNavButton" Content="🏠  Inicio" Tag="0" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNavButton_Click"/>
                    <Button x:Name="ClientsNavButton" Content="👥  Clientes" Tag="1" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNavButton_Click"/>
                    <Button x:Name="QuotesNavButton" Content="🧾  Trabajos" Tag="2" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNavButton_Click"/>
                </StackPanel>

                <StackPanel
                    x:Name="ShellFooterPanel"
                    Grid.Row="3"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center">

                    <Image
                        x:Name="ShellLogoImage"
                        Source="pack://application:,,,/Resources/logo_vector_notxt.png"
                        Width="60"
                        Height="60"
                        Stretch="Uniform"
                        SnapsToDevicePixels="True"/>

                    <TextBlock
                        x:Name="ShellFooterTextBlock"
                        Text="Martínez Mor"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Margin="2,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Column="1" Margin="14">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA FIJA CONTEXTUAL -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ShellSectionTitleTextBlock"
                        Text="Inicio"
                        FontSize="28"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="ShellSectionSubtitleTextBlock"
                        Text="Próximas entregas, vista semanal y vista mensual"
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Margin="0,2,0,0"/>

                    <TextBlock
                        x:Name="ShellBreadcrumbTextBlock"
                        Text="🏠"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MutedTextBrush}"
                        Margin="0,12,0,0"/>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="16,2,0,0">
                    <Button
                        x:Name="SettingsNavButton"
                        Content="⚙"
                        Tag="5"
                        Style="{StaticResource ShellIconButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="Ajustes"
                        Click="SidebarNavButton_Click"/>

                    <Button
                        x:Name="BackNavigationButton"
                        Content="← Atrás"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="Volver a la sección anterior"
                        Click="BackNavigationButton_Click"/>

                    <Button
                        x:Name="CreateQuoteShellButton"
                        Content="＋ Crear Presupuesto"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        ToolTip="Crear un nuevo presupuesto"
                        Click="NewQuoteButton_Click"/>
                </StackPanel>
            </Grid>
            <!-- PESTAÑAS -->
            <TabControl
                x:Name="MainTabs"
                Grid.Row="1"
                Grid.Column="0"
                FontSize="14"
                FontWeight="SemiBold"
                SelectedIndex="0"
                SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="Height" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabItem Header="Semana">
                    <views:DashboardView x:Name="DashboardView"/>
                </TabItem>

                <TabItem Header="Clientes">
                    <views:ClientesView x:Name="ClientesView"/>
                </TabItem>

                <TabItem Header="Trabajos">
                    <views:PresupuestoView x:Name="PresupuestoView"/>
                </TabItem>

                <TabItem Header="Productos">
                    <views:ProductosView x:Name="ProductosView"/>
                </TabItem>

                <TabItem Header="PDF">
                    <views:DocumentosView x:Name="DocumentosView"/>
                </TabItem>

                <TabItem Header="Ajustes">
                    <views:AjustesView x:Name="AjustesView"/>
                </TabItem>

            </TabControl>


        </Grid>

    </Grid>
</Window>